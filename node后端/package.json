{
  "name": "o2o-delivery-server",
  "version": "1.0.0",
  "description": "同城O2O配送系统 - 后端服务",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon",
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:init": "ts-node -r tsconfig-paths/register scripts/db-init.ts",
    "db:schema": "ts-node -r tsconfig-paths/register scripts/db-init.ts --schema-only",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/db-init.ts --seed-only --skip-create",
    "db:migrate": "ts-node -r tsconfig-paths/register scripts/apply-migration.ts",
    "gen:password": "ts-node -r tsconfig-paths/register scripts/generate-password.ts",
    "test:smoke": "ts-node -r tsconfig-paths/register tests/helpers/smoke.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.0.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.1",
    "node-cron": "^3.0.3",
    "redis": "^4.6.10",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  }
}
