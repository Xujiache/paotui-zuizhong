# ===========================================
# 应用配置
# ===========================================
NODE_ENV=development
APP_PORT=3000
APP_NAME=o2o-delivery
APP_SECRET=your_jwt_secret_key_here

# ===========================================
# 数据库配置
# ===========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=o2o_delivery
DB_USER=o2o_dev
DB_PASSWORD=dev_password_123
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===========================================
# Redis配置
# ===========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=o2o:

# ===========================================
# JWT配置
# ===========================================
JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# 微信小程序配置
# ===========================================
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=

# ===========================================
# 微信支付配置
# ===========================================
WX_PAY_MCH_ID=
WX_PAY_API_KEY=
WX_PAY_CERT_PATH=
WX_PAY_NOTIFY_URL=

# ===========================================
# 地图服务配置
# ===========================================
MAP_API_KEY=
MAP_JS_KEY=

# ===========================================
# 推送服务配置
# ===========================================
PUSH_APP_KEY=
PUSH_MASTER_SECRET=

# ===========================================
# 短信服务配置
# ===========================================
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE_VERIFY=
# 开发环境建议开启 Mock，发验证码不走真实短信通道
SMS_MOCK=true
SMS_MOCK_CODE=123456

# ===========================================
# 文件上传配置
# ===========================================
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
UPLOAD_URL_PREFIX=/uploads

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=debug
LOG_DIR=./logs

# ===========================================
# 定时任务配置
# ===========================================
# 设为 false 可关闭所有 cron（本地/CI 常用）
TASKS_ENABLED=true
# 商家接单超时分钟数（PRD OC-11），默认 5
MERCHANT_ACCEPT_TIMEOUT_MINUTES=5
# 送达后自动确认收货小时数（PRD OC-17），默认 24
AUTO_CONFIRM_HOURS=24
# 调度池停留多少分钟触发扩圈（PRD DC-07），默认 5
DISPATCH_EXPAND_MINUTES=5

# ===========================================
# 测试 / 调试开关
# ===========================================
# 设为 true 可跳过 authLimiter / apiLimiter（用于自动化测试），生产禁止开启
DISABLE_RATE_LIMIT=false
