# ===========================================
# 管理后台 .env 模板（不含真实值）
# 拷贝为 .env.development / .env.production 使用
# ===========================================

# 版本号
VITE_VERSION = 1.0.0

# 开发服务器端口
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = frontend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息面板
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥（请替换为随机值）
VITE_LOCK_ENCRYPT_KEY = change_me

# API 请求基础路径
# 开发环境建议 / 走 Vite 代理
# 生产环境设置为后端地址，如 https://api.example.com
VITE_API_URL = /

# 代理目标地址（开发环境 Vite 转发到此地址，解决跨域）
VITE_API_PROXY_URL = http://localhost:3000

# 是否在打包时移除 console
VITE_DROP_CONSOLE = false
