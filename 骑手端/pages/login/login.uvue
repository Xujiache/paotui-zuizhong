<template>
  <view class="container">
    <view class="logo-area">
      <text class="logo-text">同城O2O</text>
      <text class="logo-sub">骑手登录</text>
    </view>
    <view class="form-area">
      <input class="input" type="text" placeholder="请输入手机号" v-model="phone" />
      <input class="input" type="password" placeholder="请输入密码" v-model="password" />
      <button class="btn-login" @click="handleLogin">登 录</button>
    </view>
  </view>
</template>

<script lang="uts">
  export default {
    data() {
      return {
        phone: '',
        password: ''
      }
    },
    methods: {
      handleLogin() {
        if (this.phone == '' || this.password == '') {
          uni.showToast({ title: '请输入手机号和密码', icon: 'none' })
          return
        }
        uni.showToast({ title: '登录功能待开发（阶段02-03实现）', icon: 'none' })
      }
    }
  }
</script>

