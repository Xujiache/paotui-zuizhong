export const LoadFontForWX = ()=>{
	uni.loadFontFace({
		global: true,
		family: 'uxui',
		source: "url(data:font/ttf;charset=utf-8;base64,)",
		success() {
		  console.log('loadFontFace uni.ttf(base64 format) success')
		},
		fail(error) {
		  console.warn('loadFontFace uni.ttf(base64 format) fail', error.errMsg)
		},
	})
}

export const LoadFontCommon = ()=>{
	uni.loadFontFace(
	{
		global: true,
		family:"uxui",
		source:"url('/static/fonts/uxui.ttf')",
		success() {
			console.log('loadFontFace success')
		},
		fail:function(e){
			console.log(e)
		}
	});
}