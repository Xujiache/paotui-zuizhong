{
  "name": "同城O2O配送-商家端",
  "appid": "",
  "description": "同城O2O商家工作台，支持接单、商品管理、蓝牙打印、语音播报、离线推送",
  "versionName": "1.2.0",
  "versionCode": 2003120,
