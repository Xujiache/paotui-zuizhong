  font-size: 24rpx;
  color: #FF6B00;
}
.sku-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.sku-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 16rpx;
}
.sku-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.delete-btn {
  font-size: 24rpx;
  color: #F5222D;
}
.sku-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.sku-row:last-child {
  border-bottom: none;
}
.row-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #666;
}
.row-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
}
.add-row {
  margin: 20rpx 0;
}
.btn-add {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #fff;
  color: #FF6B00;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 1rpx dashed #FF6B00;
}
.footer {
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.btn-submit {
  height: 88rpx;
  line-height: 88rpx;
  background-color: #FF6B00;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
</style>
