  min-height: 100vh;
  background-color: #f5f6f8;
  display: flex;
  flex-direction: column;
}
.body {
  flex: 1;
  padding: 20rpx;
}
.shop-bar {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.shop-info {
  flex: 1;
}
.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.shop-subtitle {
  font-size: 24rpx;
  color: #52C41A;
  margin-top: 6rpx;
  display: block;
}
.status-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.status-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}
.pending-card, .today-card, .shortcut-card, .notice-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}
.pending-title, .today-title, .card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}
.pending-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}
.pending-item {
  flex: 1;
  text-align: center;
  padding: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pending-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.2;
}
.pending-item.danger .pending-num {
  color: #F5222D;
}
.pending-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.today-grid {
  display: flex;
  flex-direction: row;
}
.today-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.today-num {
  font-size: 38rpx;
  font-weight: bold;
  color: #FF6B00;
}
.today-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.shortcut-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.shortcut-item {
  width: 25%;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.shortcut-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  position: relative;
}
.shortcut-icon.orange { background-color: #FFF5EC; }
.shortcut-icon.blue { background-color: #E6F7FF; }
.shortcut-icon.green { background-color: #F6FFED; }
.shortcut-icon.purple { background-color: #F9F0FF; }
.shortcut-icon.grey { background-color: #F5F5F5; }
.shortcut-icon.red { background-color: #FFF1F0; }
.icon-emoji {
  font-size: 44rpx;
}
.icon-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: #F5222D;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-num {
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
}
.shortcut-label {
  font-size: 24rpx;
  color: #333;
}
.notice-empty {
  padding: 30rpx;
  text-align: center;
}
.empty-text {
  font-size: 26rpx;
  color: #bbb;
}
.notice-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.notice-item:last-child {
  border-bottom: none;
}
.notice-title {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.notice-time {
  font-size: 22rpx;
  color: #999;
  margin-left: 16rpx;
}
</style>
