  line-height: 44rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
}
.rank-num.rank-1 {
  background-color: #FFF1F0;
  color: #F5222D;
}
.rank-num.rank-2 {
  background-color: #FFF7E6;
