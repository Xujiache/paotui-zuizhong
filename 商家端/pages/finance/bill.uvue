<template>
  <view class="container">
    <view class="header">
      <view class="amount-card">
        <view class="amount-row">
          <text class="amount-label">可用余额</text>
          <text class="amount-value">¥{{ balanceText }}</text>
        </view>
        <view class="amount-divider"></view>
        <view class="amount-row">
          <text class="amount-label">冻结中</text>
          <text class="amount-value">¥{{ frozenText }}</text>
        </view>
      </view>
      <button class="btn-withdraw" @click="goWithdraw">申请提现</button>
    </view>

    <view class="tab-bar">
      <view :class="'tab ' + (activeTab == 'settled' ? 'active' : '')" @click="switchTab('settled')">
        <text class="tab-text">已结算</text>
      </view>
      <view :class="'tab ' + (activeTab == 'pending' ? 'active' : '')" @click="switchTab('pending')">
        <text class="tab-text">待结算</text>
      </view>
    </view>

    <scroll-view class="body" scroll-y="true" :refresher-enabled="true"
      :refresher-triggered="refreshing" @refresherrefresh="onRefresh"
      @scrolltolower="onLoadMore">

      <view v-if="loading && list.length == 0" class="loading">
        <text class="loading-text">加载中...</text>
      </view>

      <view v-else-if="list.length == 0" class="empty">
        <text class="empty-text">暂无结算记录</text>
      </view>

      <view v-else>
        <view v-for="item in list" :key="getId(item)" class="bill-card">
          <view class="bill-header">
            <text class="bill-no">单号 {{ getString(item, 'settlementNo') }}</text>
            <text :class="'bill-status ' + statusClass(getString(item, 'status'))">
              {{ statusText(getString(item, 'status')) }}
            </text>
          </view>
          <view class="bill-row">
            <text class="row-label">关联订单</text>
            <text class="row-value">#{{ getNumber(item, 'orderId') }}</text>
          </view>
          <view class="bill-row">
            <text class="row-label">订单金额</text>
            <text class="row-value">¥{{ yuanText(getNumber(item, 'orderAmount')) }}</text>
          </view>
          <view class="bill-row">
            <text class="row-label">佣金</text>
            <text class="row-value discount">-¥{{ yuanText(getNumber(item, 'commissionAmount')) }}</text>
          </view>
          <view class="bill-row">
            <text class="row-label">配送费</text>
            <text class="row-value discount">-¥{{ yuanText(getNumber(item, 'deliveryFee')) }}</text>
          </view>
          <view class="bill-row total">
            <text class="row-label">结算金额</text>
            <text class="row-value main">¥{{ yuanText(getNumber(item, 'netAmount')) }}</text>
          </view>
        </view>

        <view class="load-more">
          <text v-if="hasMore" class="load-text">上拉加载更多</text>
          <text v-else class="load-text">没有更多了</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
import { listMerchantBills, getBalance } from '@/api/settlement'
import { fenToYuan, billStatusText } from '@/utils/format'

export default {
  data() {
    return {
      balance: 0,
      frozen: 0,
      activeTab: 'settled' as string,
      list: [] as any[],
      page: 1,
      pageSize: 10,
      hasMore: true,
      refreshing: false,
      loading: false
    }
  },
  onLoad() {
    this.loadBalance()
    this.loadList(true)
  },
  onShow() {
    this.loadBalance()
  },
  computed: {
    balanceText(): string {
      return fenToYuan(this.balance)
    },
    frozenText(): string {
      return fenToYuan(this.frozen)
    }
  },
  methods: {
    getId(item: any): number {
      return (item as UTSJSONObject).getNumber('id') ?? 0
    },
    getString(item: any, key: string): string {
      return (item as UTSJSONObject).getString(key) ?? ''
    },
    getNumber(item: any, key: string): number {
      return (item as UTSJSONObject).getNumber(key) ?? 0
    },
    yuanText(fen: number): string {
      return fenToYuan(fen)
    },
    statusText(s: string): string {
      return billStatusText(s)
    },
    statusClass(s: string): string {
      if (s == 'SETTLED') return 'success'
      if (s == 'FROZEN' || s == 'PENDING') return 'pending'
      return 'default'
    },
    switchTab(tab: string) {
      if (this.activeTab == tab) return
      this.activeTab = tab
      this.loadList(true)
    },
    async loadBalance() {
      try {
        const resp = await getBalance()
        if (resp.code == 0 && resp.data != null) {
          const d = resp.data as UTSJSONObject
          this.balance = d.getNumber('balance') ?? 0
          this.frozen = d.getNumber('frozenBalance') ?? 0
        }
      } catch (e) { }
    },
    async loadList(reset: boolean = false) {
      if (reset) {
        this.page = 1
        this.hasMore = true
        this.list = []
      }
      if (!this.hasMore) return
      this.loading = true
      try {
        const resp = await listMerchantBills({
          page: this.page,
          pageSize: this.pageSize
        } as UTSJSONObject)
        if (resp.code == 0 && resp.data != null) {
          const d = resp.data as UTSJSONObject
          const list = (d['list'] as any[]) ?? []
          // 按Tab过滤
          const targetStatuses = this.activeTab == 'settled' ? ['SETTLED'] : ['PENDING', 'FROZEN']
          const filtered: any[] = []
          for (let i = 0; i < list.length; i++) {
            const it = list[i] as UTSJSONObject
            const s = it.getString('status') ?? ''
            if (targetStatuses.indexOf(s) >= 0) filtered.push(it)
          }
          if (reset) {
            this.list = filtered
          } else {
            for (let i = 0; i < filtered.length; i++) this.list.push(filtered[i])
          }
          const pagination = d['pagination'] as UTSJSONObject
          if (pagination != null) {
            const total = pagination.getNumber('total') ?? 0
            this.hasMore = this.list.length < total
          } else {
            this.hasMore = false
          }
          this.page++
        }
      } catch (e) { }
      finally {
        this.loading = false
      }
    },
    onRefresh() {
      this.refreshing = true
      this.loadList(true)
      this.loadBalance()
      this.refreshing = false
    },
    onLoadMore() {
      if (this.hasMore && !this.loading) this.loadList(false)
    },
    goWithdraw() {
      uni.navigateTo({ url: '/pages/finance/withdraw' })
    }
  }
}
</script>

<style lang="scss">
.container {
  min-height: 100vh;
  background-color: #f5f6f8;
  display: flex;
  flex-direction: column;
}
.header {
  background-color: #FF6B00;
  padding: 30rpx;
}
.amount-card {
  background-color: rgba(255,255,255,0.2);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
}
.amount-row {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.amount-label {
  font-size: 24rpx;
  color: #fff;
  opacity: 0.8;
}
.amount-value {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  margin-top: 10rpx;
}
.amount-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: rgba(255,255,255,0.3);
  margin: 0 30rpx;
}
.btn-withdraw {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #fff;
  color: #FF6B00;
  font-size: 28rpx;
  border-radius: 40rpx;
  font-weight: bold;
}
.tab-bar {
  display: flex;
  flex-direction: row;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  position: relative;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #FF6B00;
}
.tab-text {
  font-size: 28rpx;
  color: #666;
}
.tab.active .tab-text {
  color: #FF6B00;
  font-weight: bold;
}
.body {
  flex: 1;
  padding: 20rpx;
}
.loading, .empty {
  padding: 120rpx 0;
  text-align: center;
}
.loading-text, .empty-text {
  font-size: 28rpx;
  color: #bbb;
}
.bill-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}
.bill-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 16rpx;
}
.bill-no {
  font-size: 24rpx;
  color: #999;
}
.bill-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.bill-status.success {
  color: #52C41A;
  background-color: #F6FFED;
}
.bill-status.pending {
  color: #FA8C16;
  background-color: #FFF7E6;
}
.bill-status.default {
  color: #999;
  background-color: #F5F5F5;
}
.bill-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 10rpx 0;
}
.bill-row.total {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
.row-label {
  font-size: 26rpx;
  color: #666;
}
.row-value {
  font-size: 26rpx;
  color: #333;
}
.row-value.discount {
  color: #F5222D;
}
.row-value.main {
  color: #FF6B00;
  font-weight: bold;
  font-size: 30rpx;
}
.load-more {
  padding: 30rpx;
  text-align: center;
}
.load-text {
  font-size: 24rpx;
  color: #bbb;
}
</style>
