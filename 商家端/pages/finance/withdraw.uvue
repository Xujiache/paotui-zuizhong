<template>
  <view class="container">
    <scroll-view class="body" scroll-y="true" :refresher-enabled="true"
      :refresher-triggered="refreshing" @refresherrefresh="onRefresh"
      @scrolltolower="onLoadMore">

      <view class="amount-card">
        <text class="amount-label">可提现余额</text>
        <text class="amount-value">¥{{ balanceText }}</text>
      </view>

      <view class="card">
        <text class="card-title">提现金额</text>
        <view class="amount-input-row">
          <text class="amount-symbol">¥</text>
          <input class="amount-input" type="digit" placeholder="0.00" v-model="amountStr" />
          <text class="amount-all" @click="withdrawAll">全部提现</text>
        </view>
        <text class="amount-tip">最低提现 ¥1.00，单笔到账 1-3 工作日</text>
      </view>

      <view class="card">
        <text class="card-title">提现方式</text>
        <view :class="'way-item ' + (accountType == 'WECHAT' ? 'active' : '')" @click="setWay('WECHAT')">
          <text class="way-icon">💚</text>
          <text class="way-name">微信零钱</text>
          <view class="way-check">
            <text v-if="accountType == 'WECHAT'" class="check">✓</text>
          </view>
        </view>
        <view :class="'way-item ' + (accountType == 'BANK' ? 'active' : '')" @click="setWay('BANK')">
          <text class="way-icon">🏦</text>
          <text class="way-name">银行卡</text>
          <view class="way-check">
            <text v-if="accountType == 'BANK'" class="check">✓</text>
          </view>
        </view>
      </view>

      <view v-if="accountType == 'BANK'" class="card">
        <text class="card-title">银行账户信息</text>
        <view class="form-row">
          <text class="label">开户姓名</text>
          <input class="input" placeholder="与身份证姓名一致" v-model="accountName" />
        </view>
        <view class="form-row">
          <text class="label">开户银行</text>
          <input class="input" placeholder="如：工商银行" v-model="bankName" />
        </view>
        <view class="form-row">
          <text class="label">银行卡号</text>
          <input class="input" type="number" placeholder="银行卡号" v-model="accountNo" />
        </view>
      </view>

      <button class="btn-submit" @click="submit">确认提现</button>

      <view class="history-card">
        <text class="card-title">提现记录</text>
        <view v-if="history.length == 0" class="empty">
          <text class="empty-text">暂无提现记录</text>
        </view>
        <view v-else>
          <view v-for="item in history" :key="getId(item)" class="his-item">
            <view class="his-left">
              <text class="his-no">单号 {{ getString(item, 'withdrawalNo') }}</text>
              <text class="his-meta">{{ historyMeta(item) }}</text>
            </view>
            <view class="his-right">
              <text class="his-amount">¥{{ yuanText(getNumber(item, 'amount')) }}</text>
              <text :class="'his-status ' + withdrawStatusClass(getString(item, 'status'))">
                {{ withdrawStatusText(getString(item, 'status')) }}
              </text>
            </view>
          </view>
          <view v-if="hasMore" class="load-more">
            <text class="load-text">上拉加载更多</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
import { getBalance, applyWithdraw, listWithdrawals } from '@/api/settlement'
import { fenToYuan, yuanToFen, formatDateTime, withdrawStatusText as wsText } from '@/utils/format'

export default {
  data() {
    return {
      balance: 0,
      amountStr: '',
      accountType: 'WECHAT' as string,
      accountName: '',
      bankName: '',
      accountNo: '',
      history: [] as any[],
      page: 1,
      pageSize: 10,
      hasMore: true,
      refreshing: false
    }
  },
  onLoad() {
    this.loadBalance()
    this.loadHistory(true)
  },
  computed: {
    balanceText(): string {
      return fenToYuan(this.balance)
    }
  },
  methods: {
    getId(item: any): number {
      return (item as UTSJSONObject).getNumber('id') ?? 0
    },
    getString(item: any, key: string): string {
      return (item as UTSJSONObject).getString(key) ?? ''
    },
    getNumber(item: any, key: string): number {
      return (item as UTSJSONObject).getNumber(key) ?? 0
    },
    yuanText(fen: number): string {
      return fenToYuan(fen)
    },
    withdrawStatusText(s: string): string {
      return wsText(s)
    },
    withdrawStatusClass(s: string): string {
      if (s == 'SUCCESS') return 'success'
      if (s == 'REJECTED' || s == 'FAILED') return 'danger'
      if (s == 'PENDING' || s == 'TRANSFERRING') return 'pending'
      return 'default'
    },
    historyMeta(item: any): string {
      const w = item as UTSJSONObject
      const type = w.getString('accountType') ?? ''
      const t = type == 'WECHAT' ? '微信' : '银行卡'
      const created = w['createdAt']
      return `${t} · ${formatDateTime(created)}`
    },
    setWay(w: string) {
      this.accountType = w
    },
    withdrawAll() {
      this.amountStr = fenToYuan(this.balance)
    },
    async loadBalance() {
      try {
        const resp = await getBalance()
        if (resp.code == 0 && resp.data != null) {
          const d = resp.data as UTSJSONObject
          this.balance = d.getNumber('balance') ?? 0
        }
      } catch (e) { }
    },
    async loadHistory(reset: boolean = false) {
      if (reset) {
        this.page = 1
        this.hasMore = true
        this.history = []
      }
      if (!this.hasMore) return
      try {
        const resp = await listWithdrawals({
          page: this.page,
          pageSize: this.pageSize
        } as UTSJSONObject)
        if (resp.code == 0 && resp.data != null) {
          const d = resp.data as UTSJSONObject
          const list = (d['list'] as any[]) ?? []
          if (reset) {
            this.history = list
          } else {
            for (let i = 0; i < list.length; i++) this.history.push(list[i])
          }
          const pagination = d['pagination'] as UTSJSONObject
          if (pagination != null) {
            const total = pagination.getNumber('total') ?? 0
            this.hasMore = this.history.length < total
          } else {
            this.hasMore = false
          }
          this.page++
        }
      } catch (e) { }
    },
    onRefresh() {
      this.refreshing = true
      this.loadBalance()
      this.loadHistory(true)
      this.refreshing = false
    },
    onLoadMore() {
      if (this.hasMore) this.loadHistory(false)
    },
    async submit() {
      const amountYuan = parseFloat(this.amountStr)
      if (isNaN(amountYuan) || amountYuan < 1) {
        uni.showToast({ title: '最少提现 1 元', icon: 'none' })
        return
      }
      const amountFen = yuanToFen(amountYuan)
      if (amountFen > this.balance) {
        uni.showToast({ title: '超过可提现余额', icon: 'none' })
        return
      }
      if (this.accountType == 'BANK') {
        if (this.accountName == '' || this.bankName == '' || this.accountNo == '') {
          uni.showToast({ title: '请完善银行卡信息', icon: 'none' })
          return
        }
      }
      const self = this
      uni.showModal({
        title: '确认提现',
        content: `提现金额 ¥${self.amountStr}，确认提交？`,
        success: async (res) => {
          if (!res.confirm) return
          uni.showLoading({ title: '提交中...' })
          try {
            const body: UTSJSONObject = {
              amountFen: amountFen,
              accountType: self.accountType
            }
            if (self.accountType == 'BANK') {
              body['accountName'] = self.accountName
              body['bankName'] = self.bankName
              body['accountNo'] = self.accountNo
            }
            const resp = await applyWithdraw(body)
            uni.hideLoading()
            if (resp.code == 0) {
              uni.showToast({ title: '提现已提交', icon: 'success' })
              self.amountStr = ''
              setTimeout(() => {
                self.loadBalance()
                self.loadHistory(true)
              }, 500)
            }
          } catch (e) {
            uni.hideLoading()
          }
        }
      } as ShowModalOptions)
    }
  }
}
</script>

<style lang="scss">
