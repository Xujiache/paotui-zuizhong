  border-bottom: none;
}
.label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}
.input {
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
}
.btn-submit {
  height: 88rpx;
  line-height: 88rpx;
  background-color: #FF6B00;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  margin: 20rpx 0;
}
.history-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
}
