  font-size: 44rpx;
  margin-right: 20rpx;
}
.way-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.way-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.way-item.active .way-check {
  background-color: #FF6B00;
  border-color: #FF6B00;
}
