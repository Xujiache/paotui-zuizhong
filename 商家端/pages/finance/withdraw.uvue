}
.empty-text {
  font-size: 26rpx;
  color: #bbb;
}
.his-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.his-item:last-child {
  border-bottom: none;
}
.his-left {
  flex: 1;
}
.his-no {
  font-size: 24rpx;
  color: #333;
  display: block;
}
.his-meta {
  font-size: 22rpx;
