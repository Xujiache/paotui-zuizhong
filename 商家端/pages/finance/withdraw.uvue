  display: block;
}
.his-status {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.his-status.success { color: #52C41A; }
.his-status.danger { color: #F5222D; }
.his-status.pending { color: #FA8C16; }
.his-status.default { color: #999; }
