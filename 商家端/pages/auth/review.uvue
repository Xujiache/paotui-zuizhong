  min-height: 100vh;
  padding: 40rpx 30rpx;
  background-color: #f5f6f8;
}
.status-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}
.icon-box.pending {
  background-color: #FFF7E6;
}
.icon-box.approved {
  background-color: #F6FFED;
}
.icon-box.rejected {
  background-color: #FFF1F0;
}
