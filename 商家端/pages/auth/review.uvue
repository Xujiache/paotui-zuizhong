  font-size: 80rpx;
}
.status-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.status-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.reject-box {
  width: 100%;
  padding: 24rpx;
  margin-top: 30rpx;
  background-color: #FFF1F0;
  border-left: 6rpx solid #F5222D;
  border-radius: 8rpx;
  text-align: left;
}
.reject-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #F5222D;
  margin-bottom: 10rpx;
}
.reject-text {
  font-size: 26rpx;
  color: #F5222D;
  line-height: 1.5;
}
.meta {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  width: 100%;
}
.meta-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.8;
}
.actions {
  margin-top: 40rpx;
  width: 100%;
}
.btn-primary, .btn-refresh {
  height: 88rpx;
  line-height: 88rpx;
  background-color: #FF6B00;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.btn-refresh {
  background-color: #fff;
  color: #FF6B00;
  border: 1rpx solid #FF6B00;
}
.support {
  margin-top: 40rpx;
  text-align: center;
}
.support-text {
  font-size: 26rpx;
  color: #999;
}
.support-link {
  color: #FF6B00;
  margin-left: 8rpx;
}
.logout-row {
  margin-top: 40rpx;
  text-align: center;
}
.logout-text {
  font-size: 24rpx;
  color: #999;
}
</style>
