  padding: 24rpx 40rpx;
  font-size: 30rpx;
  color: #999;
  margin: 0 20rpx;
  position: relative;
}
.tab-item.active {
  color: #FF6B00;
  font-weight: bold;
  border-bottom: 4rpx solid #FF6B00;
}
.form-area {
  margin-top: 20rpx;
}
.input-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}
.input-prefix {
  font-size: 30rpx;
  color: #333;
  margin-right: 20rpx;
}
.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 100rpx;
  line-height: 100rpx;
}
.btn-code {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #FF6B00;
  background-color: #FFF5EC;
  border-radius: 32rpx;
  margin-left: 20rpx;
}
.btn-code[disabled] {
  color: #999;
  background-color: #f5f5f5;
}
.agree-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 30rpx 0;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox.checked {
  background-color: #FF6B00;
  border-color: #FF6B00;
}
.check-icon {
  color: #fff;
  font-size: 22rpx;
}
.agree-text {
  font-size: 24rpx;
  color: #666;
}
.agree-link {
  color: #FF6B00;
}
.btn-login {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #FF6B00;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  font-weight: bold;
}
.forgot-row {
  margin-top: 30rpx;
  text-align: center;
}
.forgot-text {
  font-size: 26rpx;
  color: #999;
}
.register-row {
  margin-top: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
.register-link {
  color: #FF6B00;
  margin-left: 8rpx;
}
</style>
