  padding: 0;
  overflow: hidden;
}
.logo-wrap {
  width: 100%;
  height: 320rpx;
  background-color: #f5f5f5;
}
.logo-img {
  width: 100%;
  height: 100%;
}
.logo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ph-text {
  color: #bbb;
  font-size: 26rpx;
}
.form-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-row:last-child {
  border-bottom: none;
}
.label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}
.input {
  height: 72rpx;
  font-size: 30rpx;
  color: #333;
}
.addr-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 72rpx;
}
.addr-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.arrow {
  font-size: 32rpx;
  color: #ccc;
}
.coords-row {
  padding: 10rpx 0;
}
.coords {
  font-size: 22rpx;
  color: #999;
}
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}
.announcement-input {
  width: 100%;
  height: 180rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}
.btn-save-announcement {
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  background-color: #fff;
  color: #FF6B00;
  border: 1rpx solid #FF6B00;
  font-size: 26rpx;
  border-radius: 36rpx;
}
.img-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.img-slot {
  width: 200rpx;
  height: 200rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  position: relative;
}
.prev {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.close-x {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0,0,0,0.5);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cx {
  color: #fff;
  font-size: 22rpx;
}
.img-add {
  width: 200rpx;
  height: 200rpx;
  background-color: #fafafa;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.plus {
  font-size: 60rpx;
  color: #bbb;
}
.footer {
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.btn-submit {
  height: 88rpx;
  line-height: 88rpx;
  background-color: #FF6B00;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
</style>
