<template>
  <view class="container">
    <scroll-view class="body" scroll-y="true">
      <view class="card">
        <text class="card-title">已连接的打印机</text>
        <view v-if="currentConfig == null" class="empty-row">
          <text class="empty-text">暂未连接打印机</text>
        </view>
        <view v-else class="connected-row">
          <view class="connected-info">
            <text class="dev-name">{{ currentConfig!.name }}</text>
            <text class="dev-id">{{ currentConfig!.deviceId }}</text>
          </view>
          <text class="unlink-btn" @click="onDisconnect">断开</text>
        </view>
      </view>

      <view class="card">
        <view class="card-header">
          <text class="card-title">附近蓝牙设备</text>
          <text class="scan-btn" :disabled="scanning" @click="onScan">
            {{ scanning ? '搜索中...' : '搜索' }}
          </text>
        </view>
        <view v-if="devices.length == 0" class="empty-row">
          <text class="empty-text">{{ scanned ? '未发现设备' : '点击搜索按钮开始查找' }}</text>
        </view>
        <view v-else class="dev-list">
          <view v-for="d in devices" :key="d.deviceId" class="dev-row" @click="onConnect(d)">
            <view class="dev-info">
              <text class="dev-name">{{ d.name }}</text>
              <text class="dev-rssi">信号：{{ d.RSSI }}dBm</text>
            </view>
            <text class="connect-btn">连接</text>
          </view>
        </view>
      </view>

      <view class="card">
        <text class="card-title">打印设置</text>
        <view class="setting-row">
          <text class="setting-label">接单自动打印</text>
          <switch :checked="autoPrint" color="#FF6B00" @change="onAutoPrintChange" />
        </view>
        <view class="setting-row">
          <text class="setting-label">打印联数</text>
          <view class="copies-group">
            <text v-for="n in [1, 2, 3]" :key="n"
              :class="'copies-btn ' + (copies == n ? 'active' : '')"
              @click="setCopies(n)">{{ n }}联</text>
          </view>
        </view>
      </view>

      <view class="card">
        <button class="btn-test" :disabled="currentConfig == null" @click="onTestPrint">
          测试打印
        </button>
      </view>

      <view class="tip-card">
        <text class="tip-title">温馨提示</text>
        <text class="tip-text">1. 打印前请确认打印机已开机并装好纸张</text>
        <text class="tip-text">2. 保持打印机在APP附近（10米内）</text>
        <text class="tip-text">3. 安卓12+需开启「附近的设备」权限</text>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
import {
  initBluetooth, discover, connect, discoverService, disconnect, testPrint,
  loadPrinterConfig, savePrinterConfig, BluetoothDeviceInfo, PrinterConfig
} from '@/services/printerService'
import { STORAGE_KEYS } from '@/utils/storage'

export default {
  data() {
    return {
      scanning: false,
      scanned: false,
      devices: [] as BluetoothDeviceInfo[],
      currentConfig: null as PrinterConfig | null,
      autoPrint: false,
      copies: 1
    }
  },
  onLoad() {
    this.currentConfig = loadPrinterConfig()
    const ap = uni.getStorageSync(STORAGE_KEYS.AUTO_PRINT)
    if (ap != null && typeof ap == 'boolean') this.autoPrint = ap as boolean
    const cp = uni.getStorageSync('mct_print_copies')
    if (cp != null && typeof cp == 'number') this.copies = cp as number
  },
  methods: {
    async onScan() {
      if (this.scanning) return
      this.scanning = true
      const ok = await initBluetooth()
      if (!ok) {
        this.scanning = false
        return
      }
      this.devices = []
      const found = await discover(5000)
      this.devices = found
      this.scanning = false
      this.scanned = true
      if (found.length == 0) {
        uni.showToast({ title: '未发现设备', icon: 'none' })
      }
    },
    async onConnect(d: BluetoothDeviceInfo) {
      uni.showLoading({ title: '连接中...' })
      const ok = await connect(d.deviceId)
      if (!ok) {
        uni.hideLoading()
        uni.showToast({ title: '连接失败', icon: 'none' })
        return
      }
      const discovered = await discoverService(d.deviceId)
      uni.hideLoading()
      if (!discovered) {
        uni.showToast({ title: '未找到打印服务', icon: 'none' })
        return
      }
      // 保存到本地
      const cfg: PrinterConfig = {
        name: d.name,
        deviceId: d.deviceId,
        serviceId: '',
        characteristicId: ''
      }
      savePrinterConfig(cfg)
      this.currentConfig = cfg
      uni.showToast({ title: '已连接', icon: 'success' })
    },
    async onDisconnect() {
      await disconnect()
      uni.removeStorageSync(STORAGE_KEYS.PRINTER_CONFIG)
      this.currentConfig = null
      uni.showToast({ title: '已断开', icon: 'success' })
    },
    onAutoPrintChange(e: any) {
      const d = e.detail as UTSJSONObject
      const v = d.getBoolean('value') ?? false
      this.autoPrint = v
      uni.setStorageSync(STORAGE_KEYS.AUTO_PRINT, v)
    },
    setCopies(n: number) {
      this.copies = n
      uni.setStorageSync('mct_print_copies', n)
    },
    async onTestPrint() {
      if (this.currentConfig == null) {
        uni.showToast({ title: '请先连接打印机', icon: 'none' })
        return
      }
      uni.showLoading({ title: '打印中...' })
      try {
        const ok = await testPrint()
        uni.hideLoading()
        uni.showToast({
          title: ok ? '已发送到打印机' : '打印失败',
          icon: ok ? 'success' : 'none'
        })
      } catch (e) {
        uni.hideLoading()
      }
    }
  }
}
</script>

