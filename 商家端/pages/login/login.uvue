<template>
  <view class="container">
    <view class="logo-area">
      <text class="logo-text">同城O2O</text>
      <text class="logo-sub">商家登录</text>
    </view>
    <view class="form-area">
      <input class="input" type="text" placeholder="请输入手机号" v-model="phone" maxlength="11" />
      <view v-if="loginMode == 'code'" class="row">
        <input class="input input-code" type="number" placeholder="请输入验证码" v-model="code" maxlength="6" />
        <button class="btn-code" :disabled="codeCountdown > 0" @click="handleSendCode">
          {{ codeCountdown > 0 ? codeCountdown + 's' : '获取验证码' }}
        </button>
      </view>
      <input v-else class="input" type="password" placeholder="请输入密码" v-model="password" />
      <button class="btn-login" @click="handleLogin">登 录</button>
      <view class="switch-mode" @click="toggleMode">
        <text>{{ loginMode == 'code' ? '使用密码登录' : '使用验证码登录' }}</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
  export default {
    data() {
      return {
        phone: '',
        password: '',
        code: '',
        loginMode: 'code' as string,
        codeCountdown: 0
      }
    },
    methods: {
      toggleMode() {
        this.loginMode = this.loginMode == 'code' ? 'password' : 'code'
      },
      handleSendCode() {
        if (!/^1[3-9]\d{9}$/.test(this.phone)) {
          uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
          return
        }
        // TODO: 阶段02-03 调用 /api/v1/auth/merchant/send-code
        uni.showToast({ title: '验证码发送（阶段02-03实现）', icon: 'none' })
        this.codeCountdown = 60
        const timer = setInterval(() => {
          if (this.codeCountdown <= 1) {
            clearInterval(timer)
            this.codeCountdown = 0
          } else {
            this.codeCountdown--
          }
        }, 1000)
      },
      handleLogin() {
        if (!/^1[3-9]\d{9}$/.test(this.phone)) {
          uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
          return
        }
        if (this.loginMode == 'code' && this.code == '') {
          uni.showToast({ title: '请输入验证码', icon: 'none' })
          return
        }
        if (this.loginMode == 'password' && this.password == '') {
          uni.showToast({ title: '请输入密码', icon: 'none' })
          return
        }
        // TODO: 阶段02-03 调用 /api/v1/auth/merchant/login 或 /login-pwd
        uni.showToast({ title: '登录功能待开发（阶段02-03实现）', icon: 'none' })
      }
    }
  }
</script>

<style lang="scss">
.container {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background-color: #fff;
}
.logo-area {
  text-align: center;
  padding: 80rpx 0 60rpx;
}
.logo-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #FF6B00;
}
.logo-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #999;
}
.form-area {
  margin-top: 40rpx;
}
.input {
  height: 90rpx;
  border: 1px solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 30rpx;
  font-size: 30rpx;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 30rpx;
}
.input-code {
  flex: 1;
  margin-bottom: 0;
  margin-right: 20rpx;
}
.btn-code {
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 24rpx;
  background-color: #FFF5EC;
  color: #FF6B00;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.btn-login {
  margin-top: 20rpx;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #FF6B00;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}
.switch-mode {
  margin-top: 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FF6B00;
}
</style>
