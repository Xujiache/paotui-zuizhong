  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.item-row:last-child {
  border-bottom: none;
}
.item-info {
  flex: 1;
}
.item-name {
  font-size: 28rpx;
  color: #333;
  display: block;
}
.item-spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.item-qty {
  font-size: 26rpx;
  color: #999;
  margin-right: 20rpx;
}
.item-price {
