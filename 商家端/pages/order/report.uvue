<template>
  <view class="container">
    <scroll-view class="body" scroll-y="true">
      <view class="order-box">
        <text class="order-label">关联订单</text>
        <text class="order-no">#{{ orderId }}</text>
      </view>

      <view class="section">
        <text class="section-title">异常类型</text>
        <view class="type-grid">
          <view v-for="(t, idx) in types" :key="idx"
            :class="'type-item ' + (selectedType == t.key ? 'active' : '')"
            @click="selectType(t.key)">
            <text class="type-text">{{ t.label }}</text>
          </view>
        </view>
      </view>

      <view class="section">
        <text class="section-title">详细说明</text>
        <textarea
          class="desc-input"
          placeholder="请详细描述异常情况，以便平台和用户处理"
          v-model="description"
          maxlength="500"
        />
        <text class="count">{{ description.length }}/500</text>
      </view>

      <view class="section">
        <text class="section-title">附件凭证（选填，最多5张）</text>
        <view class="img-row">
          <view v-for="(img, idx) in images" :key="idx" class="img-box">
            <image class="img" :src="img" mode="aspectFill" />
            <view class="img-close" @click="removeImg(idx)">
              <text class="x">×</text>
            </view>
          </view>
          <view v-if="images.length < 5" class="img-add" @click="chooseImg">
            <text class="plus">+</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="footer">
      <button class="btn-submit" @click="submit">提交上报</button>
    </view>
  </view>
</template>

<script lang="uts">
import { merchantReportException } from '@/api/aftersale'
import { uploadImage } from '@/api/common'

type TypeItem = {
  key: string
  label: string
}

export default {
  data() {
    return {
      orderId: 0 as number,
      selectedType: '' as string,
      description: '' as string,
      images: [] as string[],
      types: [
        { key: 'OUT_OF_STOCK', label: '缺货' } as TypeItem,
        { key: 'PRODUCT_ISSUE', label: '商品异常' } as TypeItem,
        { key: 'SHOP_CLOSED', label: '门店关闭' } as TypeItem,
        { key: 'DELIVERY_ISSUE', label: '配送问题' } as TypeItem,
        { key: 'OTHER', label: '其他' } as TypeItem,
      ] as TypeItem[]
    }
  },
  onLoad(opts: any) {
    const o = opts as UTSJSONObject
    this.orderId = o.getNumber('id') ?? 0
  },
  methods: {
    selectType(key: string) {
      this.selectedType = key
    },
    chooseImg() {
      const self = this
      uni.chooseImage({
        count: 5 - this.images.length,
        sizeType: ['compressed'],
        sourceType: ['camera', 'album'],
        success: async (res) => {
          uni.showLoading({ title: '上传中...' })
          const paths = res.tempFilePaths
          for (let i = 0; i < paths.length; i++) {
            try {
              const url = await uploadImage(paths[i])
              self.images.push(url)
            } catch (e) { }
          }
          uni.hideLoading()
        }
      } as ChooseImageOptions)
    },
    removeImg(idx: number) {
      this.images.splice(idx, 1)
    },
    async submit() {
      if (this.selectedType == '') {
        uni.showToast({ title: '请选择异常类型', icon: 'none' })
        return
      }
      if (this.description.length < 5) {
        uni.showToast({ title: '请填写详细说明（至少5字）', icon: 'none' })
        return
      }

      let selectedLabel = ''
      for (let i = 0; i < this.types.length; i++) {
        if (this.types[i].key == this.selectedType) {
          selectedLabel = this.types[i].label
          break
        }
      }

      uni.showLoading({ title: '提交中...' })
      try {
        const resp = await merchantReportException(
          this.orderId,
          selectedLabel,
          this.description
        )
        uni.hideLoading()
        if (resp.code == 0) {
          uni.showToast({ title: '已提交', icon: 'success' })
          setTimeout(() => uni.navigateBack(), 1000)
        }
      } catch (e) {
        uni.hideLoading()
      }
    }
  }
}
</script>

