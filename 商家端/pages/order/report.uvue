}
.desc-input {
  width: 100%;
  height: 200rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}
.count {
  display: block;
  font-size: 22rpx;
  color: #999;
  text-align: right;
  margin-top: 10rpx;
}
.img-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.img-box {
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
