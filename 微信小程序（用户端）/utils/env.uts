/**
 * 全局环境与常量
 * BASE_URL：后端服务根地址
 * API_PREFIX：所有业务接口统一前缀
 * CLIENT_TYPE：后端 X-Client-Type 头的值
 * DEFAULT_CITY：定位失败时的默认城市
 */

const DEV_BASE_URL = 'http://localhost:3000'
const PROD_BASE_URL = 'https://api.example.com'

// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
export const BASE_URL = DEV_BASE_URL
// #endif

// #ifdef H5
export const BASE_URL = process.env.NODE_ENV === 'production' ? PROD_BASE_URL : DEV_BASE_URL
// #endif

// #ifdef MP-WEIXIN
export const BASE_URL = DEV_BASE_URL
// #endif

export const API_PREFIX = '/api/v1'
export const CLIENT_TYPE = 'miniapp'
export const APP_NAME = '同城O2O配送'
export const APP_VERSION = '1.0.0'

export const DEFAULT_CITY = {
  province: '北京市',
  city: '北京市',
  district: '东城区',
  lat: 39.9042,
  lng: 116.4074,
}

export const DEFAULT_PAGE_SIZE = 20
export const UPLOAD_BASE_URL = BASE_URL + '/uploads'
