  }
  .faq-section {
    margin: 20rpx 24rpx 0;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
  }
  .section-title {
    display: block;
    font-size: 30rpx;
    color: #333;
    font-weight: bold;
    margin-bottom: 16rpx;
  }
  .faq-cat {
    padding: 16rpx 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .faq-cat:last-child {
    border-bottom: 0;
  }
  .faq-cat-name {
    display: block;
    color: #999;
    font-size: 26rpx;
    margin-bottom: 8rpx;
  }
