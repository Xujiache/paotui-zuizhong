    border-bottom-color: #008AFF;
  }
  .tab-text {
    color: #666;
    font-size: 28rpx;
  }
  .tab-text.active {
    color: #008AFF;
    font-weight: 500;
  }
  .coupon-wrap {
    padding: 20rpx 24rpx;
  }
  .no-coupon-row {
    background-color: #fff;
    padding: 24rpx;
    border-radius: 16rpx;
    margin-bottom: 16rpx;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .no-coupon-text {
    color: #333;
    font-size: 28rpx;
  }
  .arrow {
    color: #bbb;
    font-size: 32rpx;
  }
  .coupon-card {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 16rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .coupon-card.disabled {
    opacity: 0.6;
  }
  .coupon-left {
    width: 200rpx;
    padding-right: 24rpx;
    border-right: 1px dashed #eee;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .coupon-amount {
    color: #FF2A2A;
    font-size: 48rpx;
    font-weight: bold;
  }
  .coupon-amount.disabled {
    color: #999;
  }
  .coupon-condition {
    color: #999;
    font-size: 22rpx;
    margin-top: 8rpx;
  }
  .coupon-right {
    flex: 1;
    padding-left: 24rpx;
  }
  .coupon-name {
    color: #333;
    font-size: 28rpx;
    font-weight: 500;
  }
  .coupon-scope {
    margin-top: 6rpx;
    color: #666;
    font-size: 22rpx;
  }
  .coupon-reason {
    margin-top: 8rpx;
    color: #FF9500;
    font-size: 20rpx;
  }
  .use-btn {
    padding: 12rpx 24rpx;
    border: 1px solid #008AFF;
    border-radius: 24rpx;
  }
  .use-btn-text {
    color: #008AFF;
    font-size: 24rpx;
  }
  .empty-wrap {
    padding: 80rpx 0;
  }
</style>
