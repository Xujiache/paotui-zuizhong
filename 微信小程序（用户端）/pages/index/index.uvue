<template>
  <view class="home">
    <view class="header">
      <view class="status-bar" :style="statusBarStyle"></view>
      <view class="header-inner">
        <view class="location-row" @click="handleChooseLocation">
          <text class="loc-icon">📍</text>
          <text class="loc-text">{{ locText }}</text>
          <text class="loc-arrow">›</text>
        </view>
        <view class="search-bar" @click="goSearch">
          <text class="search-icon">🔍</text>
          <text class="search-placeholder">搜索商家、商品、跑腿服务</text>
        </view>
      </view>
    </view>

    <scroll-view class="body" scroll-y="true" @scrolltolower="loadMore">
      <view class="banner-wrap">
        <view class="banner" :style="bannerGradient">
          <text class="banner-title">欢迎使用同城O2O</text>
          <text class="banner-sub">下单立享 · 快速配送</text>
        </view>
      </view>

      <view class="entries">
        <view class="entry" @click="goCategory">
          <view class="entry-icon bg-blue"><text class="entry-icon-text">🛒</text></view>
          <text class="entry-name">外卖美食</text>
        </view>
        <view class="entry" @click="goErrand">
          <view class="entry-icon bg-green"><text class="entry-icon-text">🛵</text></view>
          <text class="entry-name">跑腿代送</text>
        </view>
        <view class="entry" @click="goCategoryWithType(2)">
          <view class="entry-icon bg-orange"><text class="entry-icon-text">🛍</text></view>
          <text class="entry-name">便利超市</text>
        </view>
        <view class="entry" @click="goCategoryWithType(3)">
          <view class="entry-icon bg-pink"><text class="entry-icon-text">🎁</text></view>
          <text class="entry-name">鲜花蛋糕</text>
        </view>
      </view>

      <view class="section-title">
        <text class="section-title-text">附近商家</text>
        <text class="section-action" @click="goMerchantList">查看全部 ›</text>
      </view>

      <view v-if="loading && merchants.length == 0" class="loading">
        <text class="loading-text">加载中...</text>
      </view>

      <view v-else-if="merchants.length == 0" class="empty-wrap">
        <EmptyState icon="🏪" text="附近暂无营业商家" subText="换个位置试试" actionText="刷新" @action="reload" />
      </view>

      <view v-else class="merchant-list">
        <MerchantCard
          v-for="item in merchants"
          :key="item.id"
          :id="item.id"
          :name="item.name"
          :logoUrl="item.logo"
          :rating="item.rating"
          :monthSales="item.monthSales"
          :distance="item.distance"
          :minOrderAmount="item.minOrderAmount"
          :deliveryFee="item.deliveryFee"
          :deliveryTime="item.deliveryTime"
          :announcement="item.announcement"
          :status="item.status"
          @click="goMerchantDetail"
        />
        <LoadMore :status="loadMoreStatus" @retry="loadMore" />
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
  import { locationState } from '@/stores/location'
  import { listNearbyStores } from '@/api/merchant'
  import MerchantCard from '@/components/MerchantCard.uvue'
  import EmptyState from '@/components/EmptyState.uvue'
  import LoadMore from '@/components/LoadMore.uvue'

  type MerchantItem = {
    id: number
    name: string
    logo: string
    rating: number
    monthSales: number
    distance: number
    minOrderAmount: number
    deliveryFee: number
    deliveryTime: number
    announcement: string
    status: string
  }

  export default {
    components: {
      MerchantCard,
      EmptyState,
      LoadMore,
    },
    data() {
      return {
        statusBarHeight: 0,
        merchants: [] as MerchantItem[],
        page: 1,
        pageSize: 10,
        total: 0,
        loading: false,
        loadMoreStatus: 'more',
      }
    },
    computed: {
      statusBarStyle(): string {
        return `height:${this.statusBarHeight}px;`
      },
      locText(): string {
        if (locationState.district != '') return locationState.district
        if (locationState.city != '') return locationState.city
        return '点击定位'
      },
      bannerGradient(): string {
        return 'background: linear-gradient(135deg, #008AFF 0%, #00C2FF 100%);'
      },
    },
    onLoad() {
      const sysInfo = uni.getSystemInfoSync()
      this.statusBarHeight = sysInfo.statusBarHeight ?? 20
      this.fetchMerchants(true)
    },
    onShow() {
      if (this.merchants.length == 0) this.fetchMerchants(true)
    },
    onPullDownRefresh() {
      this.fetchMerchants(true).then(() => {
        uni.stopPullDownRefresh()
      })
    },
    methods: {
      async fetchMerchants(reset: boolean) {
        if (this.loading) return
        this.loading = true
        if (reset) {
          this.page = 1
          this.merchants = []
        }
        try {
          const res = await listNearbyStores({
            lat: locationState.lat,
            lng: locationState.lng,
            distance: 5000,
            sortBy: 'distance',
            page: this.page,
            pageSize: this.pageSize,
          } as UTSJSONObject)
          const data = res.data as UTSJSONObject
          const list = data['list'] as UTSJSONObject[]
          const items: MerchantItem[] = []
          for (let i = 0; i < list.length; i++) {
            const it = list[i]
            items.push({
              id: it['id'] as number,
              name: it['name'] as string,
              logo: (it['logo'] as string) ?? '',
              rating: (it['rating'] as number) ?? 5.0,
              monthSales: (it['monthSales'] as number) ?? 0,
              distance: (it['distance'] as number) ?? 0,
              minOrderAmount: (it['minOrderAmount'] as number) ?? 0,
              deliveryFee: (it['deliveryFee'] as number) ?? 0,
              deliveryTime: (it['deliveryTime'] as number) ?? 30,
              announcement: (it['announcement'] as string) ?? '',
              status: (it['status'] as string) ?? 'OPEN',
            } as MerchantItem)
          }
          this.merchants = reset ? items : this.merchants.concat(items)
          const pag = data['pagination'] as UTSJSONObject
          this.total = pag['total'] as number
          if (this.merchants.length >= this.total) {
            this.loadMoreStatus = 'nomore'
          } else {
            this.loadMoreStatus = 'more'
            this.page++
          }
        } catch (e) {
          this.loadMoreStatus = 'error'
          console.error('拉取附近商家失败', e)
        } finally {
          this.loading = false
        }
      },
      loadMore() {
        if (this.loadMoreStatus != 'more') return
        this.fetchMerchants(false)
      },
      reload() {
        this.fetchMerchants(true)
      },
      goSearch() {
        uni.navigateTo({ url: '/pages/search/index' })
      },
      goCategory() {
        uni.navigateTo({ url: '/pages/category/index' })
      },
      goCategoryWithType(type: number) {
        uni.navigateTo({ url: '/pages/category/index?type=' + type })
      },
      goErrand() {
        uni.switchTab({ url: '/pages/errand/index' })
      },
      goMerchantList() {
        uni.navigateTo({ url: '/pages/merchant/list' })
      },
      goMerchantDetail(id: number) {
        uni.navigateTo({ url: '/pages/merchant/detail?id=' + id })
      },
      handleChooseLocation() {
        uni.chooseLocation({
          success: (res) => {
            const city = (res.address ?? '').substring(0, 10)
            // 这里只保存坐标，真实项目可反向 geocode 拿城市
            uni.showToast({ title: '已更新位置', icon: 'success' })
          },
          fail: () => {
            uni.showToast({ title: '定位未授权', icon: 'none' })
          },
        })
      },
    },
  }
</script>

<style lang="scss">
  .home {
    min-height: 100vh;
    background-color: #f5f6f8;
  }
  .header {
    background: linear-gradient(180deg, #008AFF 0%, #00A3FF 100%);
  }
  .header-inner {
    padding: 20rpx 24rpx 32rpx;
  }
  .location-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .loc-icon {
    color: #fff;
    font-size: 28rpx;
    margin-right: 8rpx;
  }
  .loc-text {
    color: #fff;
    font-size: 30rpx;
    font-weight: 500;
  }
  .loc-arrow {
    color: rgba(255,255,255,0.85);
    font-size: 28rpx;
    margin-left: 8rpx;
  }
  .search-bar {
    margin-top: 20rpx;
    height: 72rpx;
    background-color: #fff;
    border-radius: 36rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 24rpx;
  }
  .search-icon {
    margin-right: 16rpx;
    font-size: 28rpx;
    color: #999;
  }
  .search-placeholder {
    color: #999;
    font-size: 26rpx;
  }
  .body {
    height: calc(100vh - 200rpx);
  }
  .banner-wrap {
    padding: 24rpx;
  }
  .banner {
    height: 180rpx;
    border-radius: 16rpx;
    padding: 32rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .banner-title {
    color: #fff;
    font-size: 36rpx;
    font-weight: bold;
  }
  .banner-sub {
    margin-top: 12rpx;
    color: rgba(255,255,255,0.9);
    font-size: 24rpx;
  }
  .entries {
    display: flex;
    flex-direction: row;
    padding: 0 24rpx;
  }
  .entry {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .entry-icon {
    width: 96rpx;
    height: 96rpx;
    border-radius: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bg-blue { background-color: #E8F3FF; }
  .bg-green { background-color: #E8F9EE; }
  .bg-orange { background-color: #FFF3E0; }
  .bg-pink { background-color: #FFE8EE; }
  .entry-icon-text {
    font-size: 44rpx;
  }
  .entry-name {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #333;
  }
  .section-title {
    margin-top: 24rpx;
    padding: 20rpx 24rpx 12rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .section-title-text {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
  }
  .section-action {
    font-size: 24rpx;
    color: #666;
  }
  .merchant-list {
    padding: 0 24rpx 32rpx;
  }
  .loading {
    text-align: center;
    padding: 60rpx 0;
  }
  .loading-text {
    color: #999;
    font-size: 26rpx;
  }
  .empty-wrap {
    padding: 40rpx 0;
  }
</style>
