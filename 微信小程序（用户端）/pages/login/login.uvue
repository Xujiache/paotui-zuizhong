<template>
  <view class="container">
    <view class="logo-area">
      <view class="logo-circle">
        <text class="logo-text">O2O</text>
      </view>
      <text class="app-name">同城O2O配送</text>
      <text class="app-sub">登录后享受便捷服务</text>
    </view>

    <view class="form-area">
      <view class="btn-wechat" @click="handleWxLogin">
        <text class="btn-wechat-text">微信一键登录</text>
      </view>

      <view class="divider">
        <view class="divider-line"></view>
        <text class="divider-text">或使用手机号</text>
        <view class="divider-line"></view>
      </view>

      <view class="input-box">
        <text class="ipt-label">📱</text>
        <input class="input" type="number" placeholder="请输入手机号" v-model="phone" maxlength="11" />
      </view>
      <view class="input-box">
        <text class="ipt-label">🔒</text>
        <input class="input" type="number" placeholder="请输入验证码" v-model="code" maxlength="6" />
        <view class="btn-code" :class="{ disabled: codeCountdown > 0 }" @click="handleSendCode">
          <text class="btn-code-text">{{ codeText }}</text>
        </view>
      </view>

      <view class="btn-login" :class="{ loading: submitting }" @click="handlePhoneLogin">
        <text class="btn-login-text">{{ submitting ? '登录中...' : '登 录' }}</text>
      </view>

      <view class="agreement" @click="handleAgreeClick">
        <view class="agree-cb-box">
          <view class="agree-cb" :class="{ active: agreed }">
            <text v-if="agreed" class="agree-cb-check">✓</text>
          </view>
        </view>
        <text class="agree-text">登录即代表同意</text>
        <text class="agree-link" @click.stop="openAgreement">《用户协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link" @click.stop="openPrivacy">《隐私政策》</text>
      </view>

      <!-- 开发期辅助：点此直接登入预置的演示账号（有地址/购物车/订单数据）；
           生产发版前注释或去掉即可。 -->
      <view class="dev-tip">
        <view class="btn-demo" @click="handleDemoLogin">
          <text class="btn-demo-text">🧪 使用体验账号登录（含测试数据）</text>
        </view>
        <text class="dev-tip-text">体验账号手机号 138 0013 8888，验证码 123456</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
  import { wxLogin, phoneLogin, sendUserSmsCode } from '@/api/auth'
  import { applyLoginData } from '@/stores/user'
  import { isPhone, isSmsCode } from '@/utils/validate'

  export default {
    data() {
      return {
        phone: '',
        code: '',
        codeCountdown: 0,
        timerId: 0,
        agreed: false,
        submitting: false,
      }
    },
    computed: {
      codeText(): string {
        return this.codeCountdown > 0 ? `${this.codeCountdown}s` : '获取验证码'
      },
    },
    onUnload() {
      if (this.timerId != 0) clearInterval(this.timerId)
    },
    methods: {
      handleAgreeClick() {
        this.agreed = !this.agreed
      },
      openAgreement() {
        uni.showToast({ title: '《用户协议》待接入', icon: 'none' })
      },
      openPrivacy() {
        uni.showToast({ title: '《隐私政策》待接入', icon: 'none' })
      },
      checkAgree(): boolean {
        if (!this.agreed) {
          uni.showToast({ title: '请先同意用户协议', icon: 'none' })
          return false
        }
        return true
      },
      /**
       * 微信一键登录：按真实微信流程获取 code → 后端 wx-login → 登录成功
       * 新用户返回 hasPhone=false，由后续页面引导绑定手机号（非本页职责）
       */
      async handleWxLogin() {
        if (!this.checkAgree()) return
        if (this.submitting) return
        this.submitting = true
        uni.showLoading({ title: '登录中...' })
        uni.login({
          provider: 'weixin',
          success: async (res) => {
            try {
              const resp = await wxLogin(res.code ?? '')
              const data = resp.data as UTSJSONObject
              applyLoginData(data)
              uni.hideLoading()
              uni.showToast({ title: '登录成功', icon: 'success' })
              const hasPhone = (data['hasPhone'] as boolean) ?? false
              setTimeout(() => {
                this.submitting = false
                if (!hasPhone) {
                  uni.showToast({ title: '建议绑定手机号', icon: 'none' })
                }
                uni.navigateBack({ delta: 1 })
              }, 500)
            } catch (e) {
              uni.hideLoading()
              this.submitting = false
              uni.showToast({ title: '登录失败，请重试', icon: 'none' })
            }
          },
          fail: () => {
            uni.hideLoading()
            this.submitting = false
            uni.showToast({ title: '微信授权失败', icon: 'none' })
          },
        })
      },
      async handleSendCode() {
        if (this.codeCountdown > 0) return
        if (!isPhone(this.phone)) {
          uni.showToast({ title: '手机号格式不正确', icon: 'none' })
          return
        }
        try {
          await sendUserSmsCode(this.phone)
          uni.showToast({ title: '验证码已发送', icon: 'success' })
          this.codeCountdown = 60
          this.timerId = setInterval(() => {
            if (this.codeCountdown <= 1) {
              clearInterval(this.timerId)
              this.timerId = 0
              this.codeCountdown = 0
            } else {
              this.codeCountdown--
            }
          }, 1000) as unknown as number
        } catch (e) {
          console.error('发送验证码失败', e)
        }
      },
      /**
       * 手机号 + 验证码登录 —— 调后端真正的手机号登录接口
       */
      async handlePhoneLogin() {
        if (!this.checkAgree()) return
        if (this.submitting) return
        if (!isPhone(this.phone)) {
          uni.showToast({ title: '手机号格式不正确', icon: 'none' })
          return
        }
        if (!isSmsCode(this.code)) {
          uni.showToast({ title: '请输入正确的验证码', icon: 'none' })
          return
        }
        this.submitting = true
        uni.showLoading({ title: '登录中...' })
        try {
          const resp = await phoneLogin(this.phone, this.code)
          const data = resp.data as UTSJSONObject
          applyLoginData(data)
          uni.hideLoading()
          uni.showToast({ title: '登录成功', icon: 'success' })
          setTimeout(() => {
            this.submitting = false
            uni.navigateBack({ delta: 1 })
          }, 500)
        } catch (e) {
          uni.hideLoading()
          this.submitting = false
          // 错误提示由 request 拦截器处理
        }
      },
      /**
       * 开发期辅助：直接用演示账号登入（手机号 13800138888 + mock 验证码）
       */
      async handleDemoLogin() {
        this.submitting = true
        uni.showLoading({ title: '登入体验账号...' })
        try {
          const resp = await phoneLogin('13800138888', '123456')
          const data = resp.data as UTSJSONObject
          applyLoginData(data)
          uni.hideLoading()
          uni.showToast({ title: '登录成功', icon: 'success' })
          setTimeout(() => {
            this.submitting = false
            uni.navigateBack({ delta: 1 })
          }, 500)
        } catch (e) {
          uni.hideLoading()
          this.submitting = false
        }
      },
    },
  }
</script>

