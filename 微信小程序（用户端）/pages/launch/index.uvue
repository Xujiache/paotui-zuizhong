<template>
  <view class="launch">
    <view class="logo-wrap">
      <view class="logo-circle">
        <text class="logo-text">O2O</text>
      </view>
      <text class="app-title">同城O2O配送</text>
      <text class="app-sub">快速、便捷的本地生活服务</text>
    </view>
    <view class="progress-wrap">
      <view class="progress-bar">
        <view class="progress-fill" :style="progressStyle"></view>
      </view>
      <text class="progress-text">{{ stepText }}</text>
    </view>
    <text class="version">v{{ appVersion }}</text>
  </view>
</template>

<script lang="uts">
  import { APP_VERSION } from '@/utils/env'
  import { initUser, userState, updateUserInfo, logoutUser } from '@/stores/user'
  import { initLocation, saveLocation, locationState } from '@/stores/location'
  import { getCurrentLocation } from '@/utils/location'
  import { getProfile } from '@/api/user'

  export default {
    data() {
      return {
        progress: 0,
        stepText: '正在初始化...',
        appVersion: APP_VERSION,
      }
    },
    computed: {
      progressStyle(): string {
        return `width:${this.progress}%;`
      },
    },
    onLoad() {
      this.bootstrap()
    },
    methods: {
    async bootstrap() {
      this.stepText = '恢复登录状态...'
      this.progress = 20
      initUser()
      // 若本地有 token，主动校验一次；失败则 request 拦截器会自动尝试 refresh，
      // 失败后 clear 并跳登录。这里只负责触发校验。
      // 关键：如果 token 校验失败，request 层已经 navigateTo 跳到 /pages/login/login，
      // 我们这里就不能再 switchTab 回首页覆盖掉登录页。用 tokenInvalid 标志抑制后续跳转。
      let tokenInvalid = false
      if (userState.isLogin) {
        try {
          const res = await getProfile()
          const data = res.data as UTSJSONObject
          updateUserInfo({
            id: (data['id'] as number) ?? 0,
            nickname: (data['nickname'] as string) ?? '',
            phone: (data['phone'] as string) ?? '',
            avatar: (data['avatar'] as string) ?? '',
            gender: (data['gender'] as number) ?? 0,
          })
        } catch (e) {
          console.warn('token 校验失败，已清空登录态', e)
          logoutUser()
          tokenInvalid = true
        }
      }

      this.stepText = '获取位置信息...'
      this.progress = 60
      initLocation()
      try {
        const loc = await getCurrentLocation()
        saveLocation(loc.lat, loc.lng, loc.city, loc.district, loc.address)
      } catch (e) {
        console.warn('定位失败，使用默认城市', e)
      }

      this.stepText = '准备就绪...'
      this.progress = 100

      // token 失效时让请求层接管跳转到登录页；其他场景（未登录 / 正常登录）都可以回到首页
      if (tokenInvalid) return
      setTimeout(() => {
        uni.switchTab({ url: '/pages/index/index' })
      }, 400)
    },
    },
  }
</script>

<style lang="scss">
  .launch {
    min-height: 100vh;
    background: linear-gradient(180deg, #008AFF 0%, #0066CC 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 200rpx;
  }
  .logo-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .logo-circle {
    width: 200rpx;
    height: 200rpx;
    border-radius: 100rpx;
    background-color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  }
  .logo-text {
    color: #008AFF;
    font-size: 60rpx;
    font-weight: bold;
  }
  .app-title {
    margin-top: 40rpx;
    font-size: 48rpx;
    color: #fff;
    font-weight: bold;
  }
  .app-sub {
    margin-top: 16rpx;
    font-size: 26rpx;
    color: rgba(255,255,255,0.85);
  }
  .progress-wrap {
    margin-top: 160rpx;
    width: 60%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .progress-bar {
    width: 100%;
    height: 6rpx;
    background-color: rgba(255,255,255,0.3);
    border-radius: 3rpx;
    overflow: hidden;
  }
  .progress-fill {
    height: 6rpx;
    background-color: #fff;
    transition: width 0.3s;
  }
  .progress-text {
    margin-top: 20rpx;
    color: rgba(255,255,255,0.85);
    font-size: 24rpx;
  }
  .version {
    position: absolute;
    bottom: 60rpx;
    color: rgba(255,255,255,0.6);
    font-size: 22rpx;
  }
</style>
