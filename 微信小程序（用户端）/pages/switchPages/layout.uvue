						new UXUIDemoSubPage(
							"分段切换", 
							"/pages/layout/switch/segmentedControl"
						),			
					],
				)
			] as UXUIDemoPage[]
		}
	},
	methods: {
		open : function(index:number){
			this.currentIndex = index;
		},
		close : function(){
			this.currentIndex = -1
		},
		goto : function(path:string){
			uni.navigateTo({
				url:path
			})
		}
	},
}
