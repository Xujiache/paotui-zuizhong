<template>
  <view class="container">
    <view v-if="payStatus == 'pending' || payStatus == 'paying'" class="pay-card">
      <view class="status-icon pending">
        <text class="status-icon-text">💰</text>
      </view>
      <text class="status-title">订单已提交</text>
      <text class="status-sub">请在 {{ countdownText }} 内完成支付</text>
      <view class="amount-box">
        <text class="amount-label">订单金额</text>
        <text class="amount-num">¥{{ payAmountText }}</text>
      </view>
      <view class="method-box">
        <view class="method-row" :class="{ active: method == 'wxpay' }">
          <text class="method-icon">💚</text>
          <text class="method-name">微信支付</text>
          <text class="method-check">{{ method == 'wxpay' ? '●' : '○' }}</text>
        </view>
      </view>
      <view class="btn-pay" @click="handlePay">
        <text class="btn-pay-text">{{ payStatus == 'paying' ? '支付中...' : '立即支付 ¥' + payAmountText }}</text>
      </view>
      <text class="cancel-link" @click="handleCancel">取消订单</text>
    </view>

    <view v-else-if="payStatus == 'success'" class="result-card">
      <view class="status-icon success">
        <text class="status-icon-text">✓</text>
      </view>
      <text class="status-title success">支付成功</text>
      <text class="status-sub">订单已提交，即将为您配送</text>
      <text class="paid-amount">¥{{ payAmountText }}</text>
      <view class="result-btns">
        <view class="btn-outline" @click="goHome">
          <text class="btn-outline-text">返回首页</text>
        </view>
        <view class="btn-primary" @click="goOrderDetail">
          <text class="btn-primary-text">查看订单</text>
        </view>
      </view>
    </view>

    <view v-else-if="payStatus == 'fail'" class="result-card">
      <view class="status-icon fail">
        <text class="status-icon-text">×</text>
      </view>
      <text class="status-title fail">支付失败</text>
      <text class="status-sub">{{ failReason }}</text>
      <view class="result-btns">
        <view class="btn-outline" @click="handleCancel">
          <text class="btn-outline-text">取消订单</text>
        </view>
        <view class="btn-primary" @click="handleRetry">
          <text class="btn-primary-text">重新支付</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
  import { fen2yuan, countdownText } from '@/utils/format'
  import { getPaymentByOrderNo, mockPaymentCallback, getOrderDetail, cancelOrder } from '@/api/order'

  export default {
    data() {
      return {
        orderId: 0,
        orderNo: '',
        orderType: 'product',
        payAmount: 0,
        payStatus: 'pending',
        failReason: '',
        paymentNo: '',
        countdown: 900,
        timerId: 0,
        method: 'wxpay',
      }
    },
    computed: {
      payAmountText(): string {
        return fen2yuan(this.payAmount)
      },
      countdownText(): string {
        return countdownText(this.countdown)
      },
    },
    onLoad(query: UTSJSONObject) {
      this.orderId = Number(query['orderId'])
      this.orderNo = query['orderNo'] as string
      this.orderType = (query['orderType'] as string) ?? 'product'
      this.payAmount = Number(query['payAmount'] ?? 0)
      this.startCountdown()
      this.fetchPaymentNo()
    },
    onUnload() {
      if (this.timerId != 0) clearInterval(this.timerId)
    },
    methods: {
      async fetchPaymentNo() {
        try {
          const res = await getPaymentByOrderNo(this.orderNo)
          const data = res.data as UTSJSONObject
          this.paymentNo = (data['paymentNo'] as string) ?? ''
        } catch (e) {
          console.warn('获取支付号失败', e)
        }
      },
      startCountdown() {
        this.timerId = setInterval(() => {
          if (this.countdown <= 1) {
            clearInterval(this.timerId)
            this.timerId = 0
            this.payStatus = 'fail'
            this.failReason = '支付已超时，订单已关闭'
          } else {
            this.countdown--
          }
        }, 1000) as unknown as number
      },
      async handlePay() {
        if (this.payStatus == 'paying') return
        this.payStatus = 'paying'

        // 开发期：直接调模拟支付回调
        // 生产期：应该调 uni.requestPayment + 后端 wxpay 统一下单
        try {
          if (this.paymentNo == '') {
            await this.fetchPaymentNo()
          }
          await mockPaymentCallback(this.paymentNo, this.payAmount)
          await this.pollPaymentStatus()
        } catch (e) {
          this.payStatus = 'fail'
          this.failReason = '支付失败，请重试'
          console.error(e)
        }
      },
      async pollPaymentStatus() {
        // 轮询 3 次，每次 2 秒
        // 支付成功后订单状态会从 PENDING_PAYMENT 推进到 PENDING_MERCHANT（商品）或
        // PENDING_DISPATCH/PENDING_REVIEW（跑腿），只要不再是 PENDING_PAYMENT 就认为支付到账。
        for (let i = 0; i < 3; i++) {
          try {
            const res = await getOrderDetail(this.orderId)
            const data = res.data as UTSJSONObject
            const status = (data['status'] as string) ?? ''
            if (
              status != '' &&
              status != 'PENDING_PAYMENT' &&
              status != 'PENDING_PAY' &&
              status != 'CLOSED_UNPAID'
            ) {
              this.payStatus = 'success'
              return
            }
          } catch (e) {
            console.warn('查询订单状态失败', e)
          }
          await new Promise<void>((resolve) => {
            setTimeout(() => resolve(), 2000)
          })
        }
        this.payStatus = 'success'
      },
      async handleCancel() {
        uni.showModal({
          title: '提示',
          content: '确认取消订单？',
          success: async (res) => {
            if (res.confirm) {
              try {
                await cancelOrder(this.orderId, '用户在支付页取消')
                uni.showToast({ title: '已取消', icon: 'success' })
                setTimeout(() => {
                  uni.switchTab({ url: '/pages/order/list' })
                }, 500)
              } catch (e) {
                console.error(e)
              }
            }
          },
        })
      },
      handleRetry() {
        this.payStatus = 'pending'
        this.failReason = ''
      },
      goHome() {
        uni.switchTab({ url: '/pages/index/index' })
      },
      goOrderDetail() {
        if (this.orderType == 'errand') {
          uni.redirectTo({ url: `/pages/errand/track?id=${this.orderId}` })
        } else {
          uni.redirectTo({ url: `/pages/order/detail?id=${this.orderId}` })
        }
      },
    },
  }
</script>

