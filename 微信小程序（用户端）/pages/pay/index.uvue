    color: #07C160;
  }
  .status-title.fail {
    color: #E53935;
  }
  .status-sub {
    margin-top: 16rpx;
    color: #999;
    font-size: 26rpx;
  }
  .amount-box {
    margin-top: 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .amount-label {
    color: #999;
    font-size: 24rpx;
  }
  .amount-num {
    margin-top: 8rpx;
    color: #FF2A2A;
    font-size: 72rpx;
    font-weight: bold;
  }
  .paid-amount {
    margin-top: 32rpx;
    color: #FF2A2A;
    font-size: 60rpx;
    font-weight: bold;
  }
  .method-box {
    margin-top: 40rpx;
    width: 100%;
    border: 1px solid #eee;
    border-radius: 12rpx;
    padding: 0 24rpx;
  }
  .method-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 28rpx 0;
  }
  .method-icon {
    margin-right: 16rpx;
    font-size: 36rpx;
  }
  .method-name {
    flex: 1;
    color: #333;
    font-size: 28rpx;
  }
  .method-check {
    color: #008AFF;
    font-size: 32rpx;
  }
  .btn-pay {
    margin-top: 48rpx;
    width: 100%;
    height: 96rpx;
    background-color: #07C160;
    border-radius: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-pay-text {
    color: #fff;
    font-size: 32rpx;
    font-weight: 500;
  }
  .cancel-link {
    margin-top: 24rpx;
    color: #999;
    font-size: 26rpx;
  }
  .result-btns {
    margin-top: 48rpx;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }
  .btn-outline {
    flex: 1;
    margin-right: 24rpx;
    height: 88rpx;
    border: 1px solid #008AFF;
    border-radius: 44rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-outline-text {
    color: #008AFF;
    font-size: 28rpx;
  }
  .btn-primary {
    flex: 1;
    height: 88rpx;
    background-color: #008AFF;
    border-radius: 44rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-primary-text {
    color: #fff;
    font-size: 28rpx;
  }
</style>
