    width: 100rpx;
    height: 100rpx;
  }
  .item-img-placeholder {
    width: 100rpx;
    height: 100rpx;
    background-color: #f0f0f0;
  }
  .item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .item-name {
    font-size: 26rpx;
    color: #333;
  }
  .item-spec {
    font-size: 22rpx;
    color: #999;
  }
  .item-bottom {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }
  .item-price {
    color: #FF2A2A;
    font-size: 26rpx;
    font-weight: bold;
  }
  .item-qty {
    color: #999;
    font-size: 22rpx;
  }
  .remark-input {
    width: 100%;
    min-height: 100rpx;
    padding: 16rpx 0 0;
