    font-size: 26rpx;
    color: #666;
  }
  .addr-detail {
    margin-top: 12rpx;
    font-size: 26rpx;
    color: #555;
    line-height: 40rpx;
  }
  .section {
    margin: 0 24rpx 20rpx;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
  }
  .section-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .section-value-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .section-label {
    font-size: 28rpx;
    color: #333;
  }
  .section-value {
    font-size: 28rpx;
    color: #666;
    margin-right: 12rpx;
  }
  .section-arrow {
    color: #bbb;
    font-size: 32rpx;
  }
  .section-title {
    font-size: 28rpx;
    color: #333;
    font-weight: 600;
    padding-bottom: 16rpx;
  }
  .item-row {
    display: flex;
    flex-direction: row;
    padding: 16rpx 0;
    border-top: 1px solid #f0f0f0;
  }
  .item-row:first-child {
    border-top: 0;
  }
  .item-img-box {
    width: 100rpx;
    height: 100rpx;
    border-radius: 12rpx;
    overflow: hidden;
    margin-right: 16rpx;
  }
