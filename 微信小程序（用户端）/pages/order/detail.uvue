<template>
  <view class="container">
    <view class="status-card">
      <text class="status-text">{{ statusText }}</text>
      <text class="status-sub">{{ statusSub }}</text>
    </view>

    <view v-if="showMap" class="map-placeholder">
      <text class="map-text">📍 配送追踪</text>
      <text v-if="rider.lat > 0" class="map-sub">骑手位置: {{ rider.lat.toFixed(4) }}, {{ rider.lng.toFixed(4) }}</text>
    </view>

    <view v-if="rider.id > 0" class="rider-card">
      <view class="rider-avatar">
        <text class="rider-avatar-text">{{ riderInitial }}</text>
      </view>
      <view class="rider-info">
        <text class="rider-name">配送骑手：{{ rider.name }}</text>
        <text class="rider-sub">★ {{ rider.rating.toFixed(1) }}</text>
      </view>
      <view class="contact-btn" @click="callRider">
        <text class="contact-icon">📞</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">收货信息</text>
      <view class="addr-row">
        <text class="addr-name">{{ address.contactName }} {{ address.contactPhone }}</text>
      </view>
      <text class="addr-text">{{ fullAddress }}</text>
      <view v-if="remark != ''" class="remark-row">
        <text class="remark-label">备注：</text>
        <text class="remark-text">{{ remark }}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">{{ storeName }}</text>
      </view>
      <view v-for="it in items" :key="it.id" class="item-row">
        <view class="item-img-box">
          <image v-if="it.image != ''" class="item-img" :src="it.image" mode="aspectFill" />
          <view v-else class="item-img-placeholder"></view>
        </view>
        <view class="item-info">
          <text class="item-name">{{ it.productName }}</text>
          <text v-if="it.skuText != ''" class="item-spec">{{ it.skuText }}</text>
          <view class="item-bottom">
            <text class="item-price">¥{{ formatYuan(it.priceFen) }}</text>
            <text class="item-qty">×{{ it.quantity }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">费用明细</text>
      <view class="fee-row">
        <text class="fee-label">商品金额</text>
        <text class="fee-value">¥{{ formatYuan(productAmount) }}</text>
      </view>
      <view v-if="packingFee > 0" class="fee-row">
        <text class="fee-label">打包费</text>
        <text class="fee-value">¥{{ formatYuan(packingFee) }}</text>
      </view>
      <view v-if="deliveryFee > 0" class="fee-row">
        <text class="fee-label">配送费</text>
        <text class="fee-value">¥{{ formatYuan(deliveryFee) }}</text>
      </view>
      <view v-if="couponDiscount > 0" class="fee-row">
        <text class="fee-label">优惠券抵扣</text>
        <text class="fee-value discount">−¥{{ formatYuan(couponDiscount) }}</text>
      </view>
      <view class="fee-row total">
        <text class="fee-label total">实付金额</text>
        <text class="fee-value total">¥{{ formatYuan(payAmount) }}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">订单信息</text>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value copyable" @click="copyOrderNo">{{ orderNo }}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{ createdText }}</text>
      </view>
      <view v-if="paidAt > 0" class="info-row">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{ paidText }}</text>
      </view>
      <view class="info-row">
        <text class="info-label">支付方式</text>
        <text class="info-value">微信支付</text>
      </view>
    </view>

    <view v-if="timeline.length > 0" class="section">
      <text class="section-title">订单动态</text>
      <view v-for="(t, idx) in timeline" :key="idx" class="tl-row">
        <view class="tl-dot" :class="{ active: idx == 0 }"></view>
        <view class="tl-content">
          <text class="tl-text" :class="{ active: idx == 0 }">{{ t.text }}</text>
          <text class="tl-time">{{ t.time }}</text>
        </view>
      </view>
    </view>

    <view class="action-panel">
      <view v-for="a in actions" :key="a.type" class="btn-outline" :class="{ primary: a.primary }" @click="handleAction(a)">
        <text class="btn-outline-text" :class="{ primary: a.primary }">{{ a.label }}</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
  import { getOrderDetail, getOrderLogs, cancelOrder, completeOrder } from '@/api/order'
  import {
    fen2yuan,
    orderStatusText,
    formatDateTime,
    parseDateTs,
    isPayPending,
    isDelivered,
    isCompleted,
    isDelivering,
  } from '@/utils/format'

  type Item = {
    id: number
    productName: string
    skuText: string
    image: string
    priceFen: number
    quantity: number
  }

  type AddressVO = {
    contactName: string
    contactPhone: string
    province: string
    city: string
    district: string
    address: string
    houseNumber: string
  }

  type RiderVO = {
    id: number
    name: string
    phone: string
    rating: number
    lat: number
    lng: number
  }

  type Tl = { text: string; time: string }

  type ActionBtn = {
    type: string
    label: string
    primary: boolean
  }

  export default {
    data() {
      return {
        orderId: 0,
        orderNo: '',
        status: '',
        storeName: '',
        items: [] as Item[],
        address: {
          contactName: '',
          contactPhone: '',
          province: '',
          city: '',
          district: '',
          address: '',
          houseNumber: '',
        } as AddressVO,
        rider: { id: 0, name: '', phone: '', rating: 5.0, lat: 0, lng: 0 } as RiderVO,
        productAmount: 0,
        packingFee: 0,
        deliveryFee: 0,
        couponDiscount: 0,
        payAmount: 0,
        remark: '',
        createdAt: 0,
        paidAt: 0,
        timeline: [] as Tl[],
      }
    },
    computed: {
      statusText(): string {
        return orderStatusText(this.status)
      },
      statusSub(): string {
        const map: Map<string, string> = new Map<string, string>([
          ['PENDING_PAYMENT', '请在规定时间内完成支付'],
          ['PENDING_MERCHANT', '等待商家接单'],
          ['PENDING_RIDER', '已接单，等待骑手抢单'],
          ['PENDING_PICKUP', '骑手正在前往取货'],
          ['DELIVERING', '骑手正在配送，请耐心等候'],
          ['DELIVERED', '订单已送达，请确认收货'],
          ['COMPLETED', '订单已完成'],
          ['CANCELLED', '订单已取消'],
          ['CLOSED_UNPAID', '订单已关闭（未支付）'],
          ['MERCHANT_REJECTED', '商家已拒单，款项将原路退回'],
          ['MERCHANT_TIMEOUT', '商家超时未接单，款项将原路退回'],
          ['AFTERSALE', '售后处理中'],
          ['REFUNDED', '已退款'],
        ])
        return map.get(this.status) ?? ''
      },
      showMap(): boolean {
        return isDelivering(this.status)
      },
      riderInitial(): string {
        return this.rider.name.length > 0 ? this.rider.name.substring(0, 1) : '骑'
      },
      fullAddress(): string {
        const a = this.address
        return a.address != '' ? a.address : `${a.province}${a.city}${a.district}${a.houseNumber}`
      },
      createdText(): string {
        return this.createdAt > 0 ? formatDateTime(this.createdAt) : ''
      },
      paidText(): string {
        return this.paidAt > 0 ? formatDateTime(this.paidAt) : ''
      },
      actions(): ActionBtn[] {
        const arr: ActionBtn[] = []
        if (isPayPending(this.status)) {
          arr.push({ type: 'cancel', label: '取消订单', primary: false } as ActionBtn)
          arr.push({ type: 'pay', label: '去支付', primary: true } as ActionBtn)
        } else if (isDelivered(this.status)) {
          arr.push({ type: 'complete', label: '确认收货', primary: true } as ActionBtn)
        } else if (isCompleted(this.status)) {
          arr.push({ type: 'refund', label: '申请售后', primary: false } as ActionBtn)
          arr.push({ type: 'review', label: '评价', primary: true } as ActionBtn)
        } else if (isDelivering(this.status)) {
          arr.push({ type: 'service', label: '联系客服', primary: false } as ActionBtn)
        }
        return arr
      },
    },
    onLoad(query: UTSJSONObject) {
      this.orderId = Number(query['id'])
      this.fetchAll()
    },
    methods: {
      async fetchAll() {
        await this.fetchOrder()
        await this.fetchLogs()
      },
      async fetchOrder() {
        try {
          const res = await getOrderDetail(this.orderId)
          const data = res.data as UTSJSONObject
          this.orderNo = (data['orderNo'] as string) ?? ''
          this.status = (data['status'] as string) ?? ''
          this.storeName = (data['storeName'] as string) ?? '商家'
          this.remark = (data['userRemark'] as string) ?? ''
          // 后端返回 ISO 字符串，直接 as number 会得到非数字；走 parseDateTs 兜底
          this.createdAt = parseDateTs(data['createdAt'])
          // orders 表没有 paidAt 字段，退化用 merchant_accepted_at 作为支付时间近似
          this.paidAt = parseDateTs(data['paidAt']) > 0
            ? parseDateTs(data['paidAt'])
            : parseDateTs(data['merchantAcceptedAt'])
          this.productAmount = (data['productAmount'] as number) ?? 0
          this.packingFee = (data['packingFee'] as number) ?? 0
          this.deliveryFee = (data['deliveryFee'] as number) ?? 0
          this.couponDiscount = (data['discountAmount'] as number) ?? 0
          this.payAmount = (data['paidAmount'] as number) ?? (data['totalAmount'] as number) ?? 0

          this.address = {
            contactName: (data['contactName'] as string) ?? '',
            contactPhone: (data['contactPhone'] as string) ?? '',
            province: '',
            city: '',
            district: '',
            address: (data['deliveryAddress'] as string) ?? '',
            houseNumber: '',
          } as AddressVO

          const items = (data['items'] as UTSJSONObject[]) ?? []
          const arr: Item[] = []
          for (let i = 0; i < items.length; i++) {
            const it = items[i]
            arr.push({
              id: it['id'] as number,
              productName: (it['productName'] as string) ?? '',
              skuText: (it['skuText'] as string) ?? '',
              image: (it['productImage'] as string) ?? '',
              priceFen: (it['price'] as number) ?? 0,
              quantity: (it['quantity'] as number) ?? 1,
            } as Item)
          }
          this.items = arr

          const rider = data['rider'] as UTSJSONObject | null
          if (rider != null) {
            this.rider = {
              id: (rider['id'] as number) ?? 0,
              name: (rider['name'] as string) ?? '',
              phone: (rider['phone'] as string) ?? '',
              rating: (rider['rating'] as number) ?? 5.0,
              lat: (rider['lat'] as number) ?? 0,
              lng: (rider['lng'] as number) ?? 0,
            } as RiderVO
          }
        } catch (e) {
          console.error('订单详情加载失败', e)
        }
      },
      async fetchLogs() {
        try {
          const res = await getOrderLogs(this.orderId)
          const data = res.data as UTSJSONObject
          const list = (data['list'] as UTSJSONObject[]) ?? []
          const tl: Tl[] = []
          for (let i = list.length - 1; i >= 0; i--) {
            const it = list[i]
            const remark = (it['remark'] as string) ?? ''
            const toStatus = (it['toStatus'] as string) ?? ''
            const ts = parseDateTs(it['createdAt'])
            tl.push({
              text: remark != '' ? remark : orderStatusText(toStatus),
              time: formatDateTime(ts > 0 ? ts : Date.now()),
            } as Tl)
          }
          this.timeline = tl
        } catch (e) {
          console.warn(e)
        }
      },
      formatYuan(fen: number): string {
        return fen2yuan(fen)
      },
      callRider() {
        if (this.rider.phone == '') {
          uni.showToast({ title: '骑手电话暂不可见', icon: 'none' })
          return
        }
        uni.makePhoneCall({ phoneNumber: this.rider.phone })
      },
      copyOrderNo() {
        uni.setClipboardData({ data: this.orderNo })
      },
      async handleAction(a: ActionBtn) {
        if (a.type == 'pay') {
          uni.navigateTo({
            url: `/pages/pay/index?orderId=${this.orderId}&orderNo=${this.orderNo}&payAmount=${this.payAmount}&orderType=product`,
          })
        } else if (a.type == 'cancel') {
          uni.showModal({
            title: '提示',
            content: '确认取消订单？',
            success: async (res) => {
              if (res.confirm) {
                try {
                  await cancelOrder(this.orderId, '用户主动取消')
                  uni.showToast({ title: '已取消', icon: 'success' })
                  this.fetchAll()
                } catch (e) {
                  console.error(e)
                }
              }
            },
          })
        } else if (a.type == 'complete') {
          try {
            await completeOrder(this.orderId)
            uni.showToast({ title: '已确认收货', icon: 'success' })
            this.fetchAll()
          } catch (e) {
            console.error(e)
          }
        } else if (a.type == 'refund') {
          uni.navigateTo({ url: `/pages/order/aftersale?id=${this.orderId}&action=refund` })
        } else if (a.type == 'review') {
          uni.navigateTo({ url: `/pages/order/aftersale?id=${this.orderId}&action=review` })
        } else if (a.type == 'service') {
          uni.navigateTo({ url: '/pages/service/index' })
        }
      },
    },
  }
</script>

