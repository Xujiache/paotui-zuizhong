<template>
  <view class="container">
    <view class="header">
      <text class="title">购物车</text>
      <text v-if="groups.length > 0" class="clear-btn" @click="handleClearAll">清空</text>
    </view>

    <view v-if="loading && groups.length == 0" class="loading">
      <text class="loading-text">加载中...</text>
    </view>

    <view v-else-if="groups.length == 0" class="empty-wrap">
      <EmptyState icon="🛒" text="购物车空空如也" subText="快去选购心仪的商品吧" actionText="去逛逛" @action="goHome" />
    </view>

    <scroll-view v-else class="body" scroll-y="true">
      <view v-for="g in groups" :key="g.storeId" class="store-group">
        <view class="store-header">
          <text class="store-name">🏪 {{ g.storeName }}</text>
          <text class="clear-store" @click="handleClearStore(g.storeId)">清空</text>
        </view>
        <view v-for="it in g.items" :key="it.id" class="cart-item">
          <view class="ci-img-box">
            <image v-if="it.image != ''" class="ci-img" :src="it.image" mode="aspectFill" />
            <view v-else class="ci-img-placeholder"></view>
          </view>
          <view class="ci-info">
            <text class="ci-name">{{ it.productName }}</text>
            <text v-if="it.skuText != ''" class="ci-spec">{{ it.skuText }}</text>
            <view class="ci-bottom">
              <text class="ci-price">¥{{ formatYuan(it.priceFen) }}</text>
              <view class="qty-box">
                <view class="qty-btn" @click="handleDec(it)">
                  <text class="qty-btn-text">−</text>
                </view>
                <text class="qty-text">{{ it.quantity }}</text>
                <view class="qty-btn primary" @click="handleInc(it)">
                  <text class="qty-btn-text primary">+</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="group-footer">
          <text class="group-total">合计 ¥{{ formatYuan(groupTotal(g)) }}</text>
          <view
            class="checkout-btn"
            :class="{ disabled: !canCheckout(g) }"
            @click="handleCheckout(g)"
          >
            <text class="checkout-btn-text">{{ checkoutBtnText(g) }}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
  import { getCart, updateCartItem, removeCartItem, clearCart } from '@/api/cart'
  import { fen2yuan } from '@/utils/format'
  import { setCartCount } from '@/stores/cart'
  import EmptyState from '@/components/EmptyState.uvue'

  type CartItemVO = {
    id: number
    productId: number
    productName: string
    skuId: number
    skuText: string
    image: string
    priceFen: number
    quantity: number
    stock: number
  }

  type StoreGroup = {
    storeId: number
    storeName: string
    minOrderAmount: number
    deliveryFee: number
    items: CartItemVO[]
  }

  export default {
    components: { EmptyState },
    data() {
      return {
        groups: [] as StoreGroup[],
        loading: false,
        focusStoreId: 0,
      }
    },
    onLoad(query: UTSJSONObject) {
      const sid = query['storeId']
      if (sid != null) this.focusStoreId = Number(sid)
      this.fetchCart()
    },
    onShow() {
      this.fetchCart()
    },
    methods: {
      async fetchCart() {
        this.loading = true
        try {
          const res = await getCart()
          const data = res.data as UTSJSONObject
          // 后端返回 { groups: [{storeId, storeName, storeStatus, minOrderAmount, deliveryFee, items: [{id, productId, skuId, quantity, product: {name, image, price, stock, specText}}], totalAmount, itemCount}] }
          const rawGroups = (data['groups'] as UTSJSONObject[]) ?? []
          let totalQty = 0
          const arr: StoreGroup[] = []
          for (let i = 0; i < rawGroups.length; i++) {
            const g = rawGroups[i]
            const rawItems = (g['items'] as UTSJSONObject[]) ?? []
            const items: CartItemVO[] = []
            for (let j = 0; j < rawItems.length; j++) {
              const it = rawItems[j]
              const prod = (it['product'] as UTSJSONObject) ?? ({} as UTSJSONObject)
              const qty = it['quantity'] as number
              totalQty += qty
              items.push({
                id: it['id'] as number,
                productId: it['productId'] as number,
                productName: (prod['name'] as string) ?? '',
                skuId: it['skuId'] as number,
                skuText: (prod['specText'] as string) ?? '',
                image: (prod['image'] as string) ?? '',
                priceFen: (prod['price'] as number) ?? 0,
                quantity: qty,
                stock: (prod['stock'] as number) ?? 9999,
              } as CartItemVO)
            }
            arr.push({
              storeId: g['storeId'] as number,
              storeName: (g['storeName'] as string) ?? '商家',
              minOrderAmount: (g['minOrderAmount'] as number) ?? 0,
              deliveryFee: (g['deliveryFee'] as number) ?? 0,
              items: items,
            } as StoreGroup)
          }
          this.groups = arr
          setCartCount(totalQty)
        } catch (e) {
          console.error('购物车加载失败', e)
        } finally {
          this.loading = false
        }
      },
      formatYuan(fen: number): string {
        return fen2yuan(fen)
      },
      groupTotal(g: StoreGroup): number {
        let t = 0
        for (let i = 0; i < g.items.length; i++) {
          t += g.items[i].priceFen * g.items[i].quantity
        }
        return t
      },
      canCheckout(g: StoreGroup): boolean {
        return this.groupTotal(g) >= g.minOrderAmount
      },
      checkoutBtnText(g: StoreGroup): string {
        const total = this.groupTotal(g)
        if (total >= g.minOrderAmount) return '去结算'
        return `还差¥${fen2yuan(g.minOrderAmount - total)}起送`
      },
      async handleInc(it: CartItemVO) {
        if (it.quantity >= it.stock) {
          uni.showToast({ title: '库存不足', icon: 'none' })
          return
        }
        try {
          await updateCartItem(it.id, it.quantity + 1)
          this.fetchCart()
        } catch (e) {
          console.error(e)
        }
      },
      async handleDec(it: CartItemVO) {
        try {
          if (it.quantity <= 1) {
            await removeCartItem(it.id)
          } else {
            await updateCartItem(it.id, it.quantity - 1)
          }
          this.fetchCart()
        } catch (e) {
          console.error(e)
        }
      },
      async handleClearStore(storeId: number) {
        uni.showModal({
          title: '提示',
          content: '确认清空该商家购物车？',
          success: async (res) => {
            if (res.confirm) {
              try {
                await clearCart(storeId)
                uni.showToast({ title: '已清空', icon: 'success' })
                this.fetchCart()
              } catch (e) {
                console.error(e)
              }
            }
          },
        })
      },
      async handleClearAll() {
        uni.showModal({
          title: '提示',
          content: '确认清空购物车？',
          success: async (res) => {
            if (res.confirm) {
              try {
                await clearCart(null)
                uni.showToast({ title: '已清空', icon: 'success' })
                this.groups = []
                setCartCount(0)
              } catch (e) {
                console.error(e)
              }
            }
          },
        })
      },
      handleCheckout(g: StoreGroup) {
        if (!this.canCheckout(g)) {
          uni.showToast({ title: '未达起送价', icon: 'none' })
          return
        }
        uni.navigateTo({ url: `/pages/order/confirm?storeId=${g.storeId}` })
      },
      goHome() {
        uni.switchTab({ url: '/pages/index/index' })
      },
    },
  }
</script>

