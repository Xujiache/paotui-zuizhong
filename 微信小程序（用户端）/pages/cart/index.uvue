    justify-content: space-between;
    padding: 24rpx;
    background-color: #fff;
  }
  .title {
    font-size: 32rpx;
    color: #333;
    font-weight: bold;
  }
  .clear-btn {
    color: #008AFF;
    font-size: 26rpx;
  }
  .loading {
    padding: 120rpx 0;
    text-align: center;
  }
  .loading-text {
    color: #999;
  }
  .empty-wrap {
    padding: 120rpx 0;
  }
  .body {
    padding: 20rpx 24rpx 40rpx;
  }
  .store-group {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 0 24rpx;
    margin-bottom: 20rpx;
  }
  .store-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .store-name {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  .clear-store {
    font-size: 24rpx;
    color: #999;
  }
  .cart-item {
    display: flex;
    flex-direction: row;
    padding: 20rpx 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .ci-img-box {
    width: 140rpx;
    height: 140rpx;
    border-radius: 12rpx;
    overflow: hidden;
    margin-right: 20rpx;
  }
  .ci-img {
    width: 140rpx;
    height: 140rpx;
  }
  .ci-img-placeholder {
    width: 140rpx;
    height: 140rpx;
    background-color: #f0f0f0;
  }
  .ci-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .ci-name {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  .ci-spec {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #999;
  }
  .ci-bottom {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .ci-price {
    color: #FF2A2A;
    font-size: 30rpx;
    font-weight: bold;
  }
  .qty-box {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .qty-btn {
    width: 48rpx;
    height: 48rpx;
    border-radius: 24rpx;
    border: 1px solid #ddd;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qty-btn.primary {
    background-color: #008AFF;
    border-color: #008AFF;
  }
  .qty-btn-text {
    color: #333;
    font-size: 28rpx;
  }
  .qty-btn-text.primary {
    color: #fff;
  }
  .qty-text {
    min-width: 60rpx;
    text-align: center;
    font-size: 26rpx;
    color: #333;
  }
  .group-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
  }
  .group-total {
    color: #333;
    font-size: 28rpx;
    font-weight: 500;
  }
  .checkout-btn {
    padding: 16rpx 32rpx;
    background-color: #008AFF;
    border-radius: 32rpx;
  }
  .checkout-btn.disabled {
    background-color: #ccc;
  }
  .checkout-btn-text {
    color: #fff;
    font-size: 26rpx;
    font-weight: 500;
  }
</style>
