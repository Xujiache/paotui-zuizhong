    color: #999;
    margin-right: 12rpx;
  }
  .search-input {
    flex: 1;
    font-size: 26rpx;
    color: #333;
  }
  .clear-btn {
    color: #999;
    font-size: 32rpx;
    padding: 0 8rpx;
  }
  .cancel-btn {
    color: #008AFF;
    font-size: 28rpx;
  }
  .body {
    flex: 1;
    padding: 20rpx 24rpx;
  }
  .init-section {
    padding: 10rpx 0;
  }
  .history-card,
  .hot-card {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
  }
  .card-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
  }
  .card-title {
    color: #333;
    font-size: 28rpx;
    font-weight: 500;
  }
  .clear-history {
    color: #999;
    font-size: 24rpx;
  }
  .history-tags {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8rpx;
  }
  .history-tag,
  .hot-tag {
    padding: 10rpx 24rpx;
    margin-right: 16rpx;
    margin-top: 16rpx;
    background-color: #f5f6f8;
    border-radius: 28rpx;
  }
  .hot-tag {
    background-color: #FFF3E0;
  }
  .history-tag-text {
    color: #666;
    font-size: 24rpx;
  }
  .hot-tag-text {
    color: #FF6600;
    font-size: 24rpx;
  }
  .loading,
  .empty-wrap {
    padding: 120rpx 0;
    text-align: center;
  }
  .loading-text {
    color: #999;
  }
  .result-list {
    padding-bottom: 20rpx;
  }
  .result-card {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 20rpx;
    margin-bottom: 16rpx;
    display: flex;
    flex-direction: row;
  }
  .result-img-box {
    width: 160rpx;
    height: 160rpx;
    border-radius: 12rpx;
    overflow: hidden;
    margin-right: 20rpx;
  }
  .result-img {
    width: 160rpx;
    height: 160rpx;
  }
  .result-img-placeholder {
    width: 160rpx;
    height: 160rpx;
    background-color: #f5f6f8;
  }
  .result-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .result-name {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  .result-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #999;
  }
  .result-bottom {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .result-price {
    color: #FF2A2A;
    font-size: 30rpx;
    font-weight: bold;
  }
  .result-sales {
    color: #999;
    font-size: 22rpx;
  }
</style>
