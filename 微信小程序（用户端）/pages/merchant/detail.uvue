    font-weight: 500;
  }
  .p-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #999;
  }
  .p-sales {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #999;
  }
  .p-bottom {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 10rpx;
  }
  .p-price-box {
    display: flex;
    flex-direction: row;
    align-items: baseline;
  }
  .p-price-symbol {
    color: #FF2A2A;
