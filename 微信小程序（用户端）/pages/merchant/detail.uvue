    display: flex;
    flex-direction: row;
    padding: 20rpx 0;
  }
  .logo-wrap {
    width: 140rpx;
    height: 140rpx;
    border-radius: 16rpx;
    overflow: hidden;
    margin-right: 20rpx;
    background-color: #fff;
  }
