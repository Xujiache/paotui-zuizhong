  }
  .p-price {
    color: #FF2A2A;
    font-size: 32rpx;
    font-weight: bold;
  }
  .p-add-btn {
    padding: 8rpx 20rpx;
    background-color: #008AFF;
    border-radius: 22rpx;
  }
  .p-add-text {
    color: #fff;
    font-size: 22rpx;
    font-weight: 500;
  }
  .p-qty-box {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .qty-btn {
    width: 44rpx;
    height: 44rpx;
    border-radius: 22rpx;
    border: 1px solid #008AFF;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qty-btn.primary {
    background-color: #008AFF;
  }
  .qty-btn.primary .qty-btn-text {
    color: #fff;
  }
  .qty-btn-text {
    font-size: 28rpx;
    color: #008AFF;
    font-weight: bold;
  }
  .qty-text {
