    width: 140rpx;
    height: 140rpx;
  }
  .logo-placeholder {
    width: 140rpx;
    height: 140rpx;
    background-color: rgba(255,255,255,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logo-placeholder-text {
    color: #fff;
    font-size: 48rpx;
    font-weight: bold;
  }
  .store-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .store-name {
    color: #fff;
    font-size: 32rpx;
    font-weight: bold;
  }
  .store-row {
    display: flex;
    flex-direction: row;
    margin-top: 8rpx;
  }
  .rating {
    color: #FFD700;
    font-size: 24rpx;
    margin-right: 16rpx;
  }
  .sales {
    color: rgba(255,255,255,0.85);
    font-size: 22rpx;
  }
  .meta {
    color: rgba(255,255,255,0.85);
    font-size: 22rpx;
    margin-right: 16rpx;
  }
  .announce {
    margin-top: 8rpx;
    padding: 6rpx 12rpx;
    background-color: rgba(255,255,255,0.2);
    border-radius: 6rpx;
  }
  .announce-text {
    color: #fff;
    font-size: 22rpx;
  }
  .body-wrap {
    flex: 1;
    display: flex;
    flex-direction: row;
    padding-bottom: 120rpx;
  }
  .cat-side {
    width: 180rpx;
    background-color: #f0f0f0;
  }
  .cat-scroll {
    height: 100%;
  }
  .cat-item {
    padding: 28rpx 16rpx;
    text-align: center;
    border-left: 4rpx solid transparent;
  }
  .cat-item.active {
    background-color: #fff;
    border-left-color: #008AFF;
  }
  .cat-text {
    font-size: 26rpx;
    color: #666;
  }
  .cat-text.active {
    color: #008AFF;
    font-weight: 500;
  }
  .product-side {
    flex: 1;
    background-color: #fff;
    padding: 20rpx 0;
  }
  .loading {
    text-align: center;
    padding: 80rpx 0;
  }
  .loading-text {
    color: #999;
  }
  .empty-wrap {
    padding-top: 80rpx;
  }
  .product-list {
    padding-bottom: 20rpx;
  }
  .product-row {
    display: flex;
    flex-direction: row;
    padding: 20rpx;
    border-bottom: 1px solid #f0f0f0;
  }
  .p-img-box {
    width: 160rpx;
    height: 160rpx;
    border-radius: 12rpx;
    overflow: hidden;
    margin-right: 16rpx;
  }
  .p-img {
    width: 160rpx;
    height: 160rpx;
  }
  .p-img-placeholder {
    width: 160rpx;
    height: 160rpx;
    background-color: #f5f6f8;
  }
  .p-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .p-name {
    font-size: 28rpx;
