<template>
  <view class="container">
    <view class="tab-bar">
      <view v-for="t in tabs" :key="t.value" class="tab" :class="{ active: activeTab == t.value }" @click="switchTab(t.value)">
        <text class="tab-text" :class="{ active: activeTab == t.value }">{{ t.label }}</text>
      </view>
      <text class="read-all" @click="handleReadAll">全部已读</text>
    </view>

    <scroll-view class="body" scroll-y="true" @scrolltolower="loadMore">
      <view v-if="loading && list.length == 0" class="loading">
        <text class="loading-text">加载中...</text>
      </view>
      <view v-else-if="list.length == 0" class="empty-wrap">
        <EmptyState icon="🔔" text="暂无消息" />
      </view>
      <view v-else class="msg-list">
        <view v-for="m in list" :key="m.id" class="msg-card" @click="handleRead(m)">
          <view class="msg-icon-box" :style="'background-color:' + iconBg(m.type)">
            <text class="msg-icon">{{ iconOf(m.type) }}</text>
          </view>
          <view class="msg-info">
            <view class="msg-header">
              <text class="msg-title" :class="{ unread: !m.isRead }">{{ m.title }}</text>
              <text class="msg-time">{{ m.timeText }}</text>
            </view>
            <text class="msg-content">{{ m.content }}</text>
          </view>
          <view v-if="!m.isRead" class="unread-dot"></view>
        </view>
        <LoadMore :status="loadMoreStatus" @retry="loadMore" />
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
  import { listMessages, markRead, markAllRead } from '@/api/message'
  import { relativeTime, parseDateTs } from '@/utils/format'
  import EmptyState from '@/components/EmptyState.uvue'
  import LoadMore from '@/components/LoadMore.uvue'

  type TabItem = {
    label: string
    value: string
  }

  type MsgItem = {
    id: number
    type: string
    title: string
    content: string
    isRead: boolean
    createdAt: number
    timeText: string
    // 后端消息模型只返回 extra 字段（JSON），跳转信息在 extra.linkType / extra.linkValue 里，
    // 之前直接读顶层 linkType/linkValue 永远拿不到，导致点消息不跳转。
    linkType: string
    linkValue: string
  }

  export default {
    components: { EmptyState, LoadMore },
    data() {
      return {
        tabs: [
          { label: '全部', value: 'ALL' } as TabItem,
          { label: '订单', value: 'ORDER' } as TabItem,
          { label: '活动', value: 'ACTIVITY' } as TabItem,
          { label: '系统', value: 'SYSTEM' } as TabItem,
        ] as TabItem[],
        activeTab: 'ALL',
        list: [] as MsgItem[],
        page: 1,
        pageSize: 20,
        total: 0,
        loading: false,
        loadMoreStatus: 'more',
      }
    },
    onLoad() {
      this.fetchList(true)
    },
    methods: {
      async fetchList(reset: boolean) {
        if (this.loading) return
        this.loading = true
        if (reset) {
          this.page = 1
          this.list = []
        }
        try {
          const params: UTSJSONObject = { page: this.page, pageSize: this.pageSize } as UTSJSONObject
          if (this.activeTab != 'ALL') {
            params['type'] = this.activeTab
          }
          const res = await listMessages(params)
          const data = res.data as UTSJSONObject
          const rawList = (data['list'] as UTSJSONObject[]) ?? []
          const arr: MsgItem[] = []
          for (let i = 0; i < rawList.length; i++) {
            const it = rawList[i]
            const ts = parseDateTs(it['createdAt'])
            // 后端消息 DTO 把跳转信息放在 extra 对象里（可能为 null）；linkType / linkValue 没在顶层
            const extra = it['extra'] as UTSJSONObject | null
            const linkType = extra != null ? ((extra['linkType'] as string) ?? 'none') : 'none'
            const linkValue = extra != null ? ((extra['linkValue'] as string) ?? '') : ''
            arr.push({
              id: it['id'] as number,
              type: (it['type'] as string) ?? 'SYSTEM',
              title: (it['title'] as string) ?? '',
              content: (it['content'] as string) ?? '',
              isRead: (it['isRead'] as boolean) ?? false,
              createdAt: ts,
              timeText: ts > 0 ? relativeTime(ts) : '',
              linkType: linkType,
              linkValue: linkValue,
            } as MsgItem)
          }
          this.list = reset ? arr : this.list.concat(arr)
          const pag = data['pagination'] as UTSJSONObject
          this.total = (pag['total'] as number) ?? arr.length
          if (this.list.length >= this.total) {
            this.loadMoreStatus = 'nomore'
          } else {
            this.loadMoreStatus = 'more'
            this.page++
          }
        } catch (e) {
          this.loadMoreStatus = 'error'
        } finally {
          this.loading = false
        }
      },
      switchTab(v: string) {
        if (this.activeTab == v) return
        this.activeTab = v
        this.fetchList(true)
      },
      loadMore() {
        if (this.loadMoreStatus != 'more') return
        this.fetchList(false)
      },
      iconOf(type: string): string {
        if (type == 'ORDER') return '📦'
        if (type == 'ACTIVITY') return '🎉'
        return '📢'
      },
      iconBg(type: string): string {
        if (type == 'ORDER') return '#E8F3FF'
        if (type == 'ACTIVITY') return '#FFF3E0'
        return '#F0F0F0'
      },
      async handleRead(m: MsgItem) {
        if (!m.isRead) {
          try {
            await markRead(m.id)
            m.isRead = true
          } catch (e) {
            console.warn(e)
          }
        }
        if (m.linkType == 'ORDER' && m.linkValue != '') {
          uni.navigateTo({ url: `/pages/order/detail?id=${m.linkValue}` })
        }
      },
      async handleReadAll() {
        try {
          await markAllRead()
          uni.showToast({ title: '已全部标记已读', icon: 'success' })
          this.fetchList(true)
        } catch (e) {
          console.error(e)
        }
      },
    },
  }
</script>

<style lang="scss">
  .container {
    height: 100vh;
    background-color: #f5f6f8;
    display: flex;
    flex-direction: column;
  }
  .tab-bar {
    display: flex;
    flex-direction: row;
    background-color: #fff;
    padding: 0 24rpx;
    border-bottom: 1px solid #f0f0f0;
    align-items: center;
  }
  .tab {
    flex: 1;
    text-align: center;
    padding: 24rpx 0;
    border-bottom: 4rpx solid transparent;
  }
  .tab.active {
    border-bottom-color: #008AFF;
  }
  .tab-text {
    color: #666;
    font-size: 26rpx;
  }
  .tab-text.active {
    color: #008AFF;
    font-weight: 500;
  }
  .read-all {
    color: #008AFF;
    font-size: 24rpx;
  }
  .body {
    flex: 1;
    padding: 20rpx 24rpx;
  }
  .loading {
    padding: 80rpx 0;
    text-align: center;
  }
  .loading-text {
    color: #999;
  }
  .empty-wrap {
    padding: 80rpx 0;
  }
  .msg-list {
    padding-bottom: 40rpx;
  }
  .msg-card {
    position: relative;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 20rpx;
    margin-bottom: 16rpx;
    display: flex;
    flex-direction: row;
  }
  .msg-icon-box {
    width: 72rpx;
    height: 72rpx;
    border-radius: 36rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16rpx;
  }
  .msg-icon {
    font-size: 32rpx;
  }
  .msg-info {
    flex: 1;
  }
  .msg-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .msg-title {
    color: #333;
    font-size: 28rpx;
  }
  .msg-title.unread {
    font-weight: bold;
  }
  .msg-time {
    color: #999;
    font-size: 22rpx;
  }
  .msg-content {
    margin-top: 6rpx;
    color: #666;
    font-size: 24rpx;
    line-height: 34rpx;
  }
  .unread-dot {
    position: absolute;
    right: 24rpx;
    top: 24rpx;
    width: 16rpx;
    height: 16rpx;
    border-radius: 8rpx;
    background-color: #FF2A2A;
  }
</style>
