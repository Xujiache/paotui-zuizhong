/**
 * 用户全局状态：accessToken + refreshToken + userInfo
 * 字段与后端 UserInfoData 保持一致：id / nickname / avatar / phone / gender
 */
import { getToken, setToken, clearToken } from '@/api/request'
import { STORAGE_KEYS, setStorage, getObject, getString, removeStorage } from '@/utils/storage'

export type UserInfo = {
  id: number
  nickname: string
  avatar: string
  phone: string
  gender: number
}

export type UserState = {
  accessToken: string
  refreshToken: string
  userInfo: UserInfo | null
  isLogin: boolean
}

export const userState = reactive({
  accessToken: '',
  refreshToken: '',
  userInfo: null,
  isLogin: false,
} as UserState)

/**
 * 应用启动时：从 Storage 恢复登录态（只恢复，不主动校验；校验交给启动页/首个受保护接口）
 */
export const initUser = () => {
  const t = getToken()
  const rt = getString(STORAGE_KEYS.REFRESH_TOKEN)
  if (t != '') {
    userState.accessToken = t
    userState.refreshToken = rt
    userState.isLogin = true
    const cached = getObject(STORAGE_KEYS.USER_INFO)
    if (cached != null) {
      userState.userInfo = cached as UserInfo
    }
  }
}

/**
 * 保存登录成功后返回的一组凭证与资料（同 WxLoginResponseData）
 */
export const applyLoginData = (data: UTSJSONObject) => {
  const accessToken = (data['accessToken'] as string) ?? ''
  const rt = (data['refreshToken'] as string) ?? ''
  if (accessToken != '') {
    setToken(accessToken)
    userState.accessToken = accessToken
  }
  if (rt != '') {
    setStorage(STORAGE_KEYS.REFRESH_TOKEN, rt)
    userState.refreshToken = rt
  }
  userState.isLogin = true

  const info = data['userInfo'] as UTSJSONObject | null
  if (info != null) {
    const u: UserInfo = {
      id: (info['id'] as number) ?? 0,
      nickname: (info['nickname'] as string) ?? '',
      avatar: (info['avatar'] as string) ?? '',
      phone: (info['phone'] as string) ?? '',
      gender: (info['gender'] as number) ?? 0,
    }
    setStorage(STORAGE_KEYS.USER_INFO, u)
    userState.userInfo = u
  }
}

/**
 * 仅更新用户资料（不改 token）
 */
export const updateUserInfo = (info: UserInfo) => {
  setStorage(STORAGE_KEYS.USER_INFO, info)
  userState.userInfo = info
}

/**
 * 仅刷新 accessToken（被 request 拦截器使用）
 */
export const setAccessToken = (token: string) => {
  setToken(token)
  userState.accessToken = token
}

/**
 * 登出：清空所有
 */
export const logoutUser = () => {
  clearToken()
  removeStorage(STORAGE_KEYS.USER_INFO)
  userState.accessToken = ''
  userState.refreshToken = ''
  userState.userInfo = null
  userState.isLogin = false
}

export const getRefreshToken = (): string => {
  if (userState.refreshToken != '') return userState.refreshToken
  const rt = getString(STORAGE_KEYS.REFRESH_TOKEN)
  if (rt != '') userState.refreshToken = rt
  return rt
}
