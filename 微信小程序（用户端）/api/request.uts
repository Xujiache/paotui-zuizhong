/**
 * 网络请求基础封装
 * - 统一附加 JWT Bearer
 * - code !=0 统一提示
 * - 401 自动尝试 refresh token 刷新后重试（单次），再失败才跳登录
 * - 并发 401 去重：多个请求同时失败只跳一次登录页
 * - 提供 get/post/put/del/patch 语法糖
 */

import { BASE_URL, API_PREFIX, CLIENT_TYPE } from '@/utils/env'
import { STORAGE_KEYS, setStorage, getString, removeStorage } from '@/utils/storage'

export type RequestOptions = {
  url: string
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH'
  data?: any | null
  header?: UTSJSONObject | null
  hideErrorToast?: boolean
  noAuth?: boolean
  noPrefix?: boolean
  _retried?: boolean
}

export type ApiResponse = {
  code: number
  message: string
  data: any | null
}

export type Pagination = {
  list: any[]
  pagination: PaginationMeta
}

export type PaginationMeta = {
  page: number
  pageSize: number
  total: number
  totalPages: number
}

let _token = ''
let _isRefreshing = false
let _hasRedirectedToLogin = false
let _refreshingPromise: Promise<boolean> | null = null

export const setToken = (t: string) => {
  _token = t
  setStorage(STORAGE_KEYS.TOKEN, t)
}

export const getToken = (): string => {
  if (_token == '') {
    _token = getString(STORAGE_KEYS.TOKEN)
  }
  return _token
}

export const clearToken = () => {
  _token = ''
  removeStorage(STORAGE_KEYS.TOKEN)
  removeStorage(STORAGE_KEYS.REFRESH_TOKEN)
  removeStorage(STORAGE_KEYS.USER_INFO)
}

const buildFullUrl = (url: string, noPrefix: boolean): string => {
  if (url.startsWith('http://') || url.startsWith('https://')) return url
  if (noPrefix) return BASE_URL + url
  return BASE_URL + API_PREFIX + url
}

/**
 * 调用刷新接口：成功则更新内存 + Storage 的 accessToken，返回 true；失败返回 false
 * 并发场景下只发一次刷新请求，其余调用复用同一个 Promise
 */
const tryRefreshToken = (): Promise<boolean> => {
  if (_refreshingPromise != null) return _refreshingPromise!

  const rt = getString(STORAGE_KEYS.REFRESH_TOKEN)
  if (rt == '') {
    return new Promise<boolean>((resolve) => resolve(false))
  }

  _isRefreshing = true
  _refreshingPromise = new Promise<boolean>((resolve) => {
    uni.request({
      url: BASE_URL + API_PREFIX + '/auth/refresh-token',
      method: 'POST',
      data: { refreshToken: rt } as UTSJSONObject,
      header: {
        'Content-Type': 'application/json',
        'X-Client-Type': CLIENT_TYPE,
      } as UTSJSONObject,
      timeout: 10000,
      success: (res) => {
        if (res.statusCode == 200) {
          const body = res.data as ApiResponse
          if (body != null && body.code == 0) {
            const d = body.data as UTSJSONObject
            const newAccess = (d['accessToken'] as string) ?? ''
            const newRefresh = (d['refreshToken'] as string) ?? ''
            if (newAccess != '') {
              _token = newAccess
              setStorage(STORAGE_KEYS.TOKEN, newAccess)
            }
            if (newRefresh != '') {
              setStorage(STORAGE_KEYS.REFRESH_TOKEN, newRefresh)
            }
            _isRefreshing = false
            _refreshingPromise = null
            resolve(true)
            return
          }
        }
        _isRefreshing = false
        _refreshingPromise = null
        resolve(false)
      },
      fail: () => {
        _isRefreshing = false
        _refreshingPromise = null
        resolve(false)
      },
    })
  })
  return _refreshingPromise!
}

const redirectToLogin = () => {
  if (_hasRedirectedToLogin) return
  _hasRedirectedToLogin = true
  clearToken()
  // 稍后自动重置标志，避免下次登录后还卡住
  setTimeout(() => {
    _hasRedirectedToLogin = false
  }, 2000)
  uni.showToast({ title: '登录已过期，请重新登录', icon: 'none' })
  uni.navigateTo({ url: '/pages/login/login' })
}

export const request = (options: RequestOptions): Promise<ApiResponse> => {
  return new Promise((resolve, reject) => {
    const header = options.header ?? ({} as UTSJSONObject)
    header['Content-Type'] = 'application/json'
    header['X-Client-Type'] = CLIENT_TYPE

    if (options.noAuth != true) {
      const t = getToken()
      if (t != '') {
        header['Authorization'] = 'Bearer ' + t
      }
    }

    const fullUrl = buildFullUrl(options.url, options.noPrefix == true)
    const method = options.method ?? 'GET'

    uni.request({
      url: fullUrl,
      method: method,
      data: options.data,
      header: header,
      timeout: 15000,
      success: async (res) => {
        const statusCode = res.statusCode
        const body = res.data as ApiResponse

        if (statusCode == 401) {
          // 先尝试用 refresh token 刷新，一次机会
          if (options._retried != true && options.noAuth != true) {
            const ok = await tryRefreshToken()
            if (ok) {
              const retryOpt: RequestOptions = {
                url: options.url,
                method: options.method,
                data: options.data,
                header: options.header,
                hideErrorToast: options.hideErrorToast,
                noAuth: options.noAuth,
                noPrefix: options.noPrefix,
                _retried: true,
              }
              try {
                const r = await request(retryOpt)
                resolve(r)
              } catch (e) {
                reject(e)
              }
              return
            }
          }
          redirectToLogin()
          reject(new Error('UNAUTHORIZED'))
          return
        }

        if (statusCode >= 500) {
          if (options.hideErrorToast != true) {
            uni.showToast({ title: '服务异常，请稍后重试', icon: 'none' })
          }
          reject(new Error('SERVER_ERROR'))
          return
        }

        if (body != null && body.code != 0) {
          if (options.hideErrorToast != true) {
            const msg = body.message != '' ? body.message : '请求失败'
            uni.showToast({ title: msg, icon: 'none' })
          }
          reject(new Error(body.message))
          return
        }

        resolve(body)
      },
      fail: (err) => {
        if (options.hideErrorToast != true) {
          uni.showToast({ title: '网络异常，请检查网络', icon: 'none' })
        }
        reject(new Error(err.errMsg ?? 'NETWORK_ERROR'))
      },
    })
  })
}

export const get = (url: string, data?: any | null, opts?: UTSJSONObject | null): Promise<ApiResponse> => {
  return request({
    url: url,
    method: 'GET',
    data: data,
    hideErrorToast: opts?.['hideErrorToast'] as boolean ?? false,
    noAuth: opts?.['noAuth'] as boolean ?? false,
  } as RequestOptions)
}

export const post = (url: string, data?: any | null, opts?: UTSJSONObject | null): Promise<ApiResponse> => {
  return request({
    url: url,
    method: 'POST',
    data: data,
    hideErrorToast: opts?.['hideErrorToast'] as boolean ?? false,
    noAuth: opts?.['noAuth'] as boolean ?? false,
  } as RequestOptions)
}

export const put = (url: string, data?: any | null): Promise<ApiResponse> => {
  return request({ url: url, method: 'PUT', data: data } as RequestOptions)
}

export const del = (url: string, data?: any | null): Promise<ApiResponse> => {
  return request({ url: url, method: 'DELETE', data: data } as RequestOptions)
}

export const patch = (url: string, data?: any | null): Promise<ApiResponse> => {
  return request({ url: url, method: 'PATCH', data: data } as RequestOptions)
}
