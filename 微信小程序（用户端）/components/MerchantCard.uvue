<template>
  <view class="merchant" @click="handleClick">
    <view class="logo">
      <image v-if="logoUrl != ''" class="logo-img" :src="logoUrl" mode="aspectFill" />
      <view v-else class="logo-placeholder">
        <text class="logo-placeholder-text">{{ firstChar }}</text>
      </view>
    </view>
    <view class="info">
      <view class="row-title">
        <text class="name">{{ name }}</text>
        <text v-if="status != 'OPEN'" class="tag-closed">休息中</text>
      </view>
      <view class="row">
        <text class="rating">★ {{ formatRating(rating) }}</text>
        <text class="sales">月售 {{ monthSales }}</text>
        <text class="distance">{{ distanceText }}</text>
      </view>
      <view class="row">
        <text class="delivery">起送 ¥{{ formatYuan(minOrderAmount) }}</text>
        <text class="delivery">配送 ¥{{ formatYuan(deliveryFee) }}</text>
        <text class="delivery">约{{ deliveryTime }}分钟</text>
      </view>
      <view v-if="announcement != ''" class="announcement">
        <text class="announcement-text">公告：{{ announcement }}</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
  import { fen2yuan, distanceText } from '@/utils/format'

  export default {
    name: 'MerchantCard',
    props: {
      id: { type: Number, default: 0 },
      name: { type: String, default: '' },
      logoUrl: { type: String, default: '' },
      rating: { type: Number, default: 5.0 },
      monthSales: { type: Number, default: 0 },
      distance: { type: Number, default: 0 },
      minOrderAmount: { type: Number, default: 0 },
      deliveryFee: { type: Number, default: 0 },
      deliveryTime: { type: Number, default: 30 },
      announcement: { type: String, default: '' },
      status: { type: String, default: 'OPEN' },
    },
    emits: ['click'],
    computed: {
      firstChar(): string {
        return this.name.length > 0 ? this.name.substring(0, 1) : '店'
      },
      distanceText(): string {
        return distanceText(this.distance)
      },
    },
    methods: {
      formatYuan(fen: number): string {
        return fen2yuan(fen)
      },
      formatRating(r: number): string {
        return r.toFixed(1)
      },
      handleClick() {
        this.$emit('click', this.id)
      },
    },
  }
</script>

