  .merchant {
    display: flex;
    flex-direction: row;
    padding: 24rpx;
    background-color: #fff;
    margin-bottom: 16rpx;
    border-radius: 16rpx;
  }
  .logo {
    width: 160rpx;
    height: 160rpx;
    border-radius: 16rpx;
    overflow: hidden;
    margin-right: 20rpx;
  }
  .logo-img {
    width: 160rpx;
    height: 160rpx;
  }
  .logo-placeholder {
    width: 160rpx;
    height: 160rpx;
    background-color: #E8F3FF;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logo-placeholder-text {
    font-size: 64rpx;
    color: #008AFF;
    font-weight: bold;
  }
  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .row-title {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .name {
    font-size: 30rpx;
    color: #333;
    font-weight: 600;
    flex: 1;
  }
  .tag-closed {
    padding: 4rpx 12rpx;
    background-color: #FFF1F0;
    color: #E53935;
    font-size: 20rpx;
    border-radius: 8rpx;
  }
  .row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 8rpx;
  }
  .rating {
    color: #FF9500;
    font-size: 24rpx;
    margin-right: 16rpx;
  }
  .sales {
    color: #999;
    font-size: 22rpx;
    margin-right: 16rpx;
  }
  .distance {
    color: #999;
    font-size: 22rpx;
  }
  .delivery {
    color: #666;
    font-size: 22rpx;
    margin-right: 16rpx;
  }
  .announcement {
    margin-top: 8rpx;
    padding: 6rpx 12rpx;
    background-color: #FFF7E6;
    border-radius: 6rpx;
  }
  .announcement-text {
    color: #B07A00;
    font-size: 22rpx;
  }
</style>
