    background-color: #F5F6F8;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .img-placeholder-text {
    color: #ccc;
    font-size: 24rpx;
  }
  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .name {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  .desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #999;
  }
  .tags-row {
    display: flex;
    flex-direction: row;
    margin-top: 8rpx;
  }
  .tag-sale {
    font-size: 22rpx;
    color: #999;
    margin-right: 16rpx;
  }
  .tag-rating {
    font-size: 22rpx;
    color: #FF9500;
  }
  .bottom-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 10rpx;
  }
  .price-box {
    display: flex;
    flex-direction: row;
    align-items: baseline;
  }
  .price-symbol {
    color: #FF2A2A;
    font-size: 22rpx;
  }
  .price {
    color: #FF2A2A;
    font-size: 32rpx;
    font-weight: bold;
  }
  .price-original {
    margin-left: 10rpx;
    color: #999;
    font-size: 22rpx;
    text-decoration: line-through;
  }
  .add-btn {
    width: 44rpx;
    height: 44rpx;
    border-radius: 22rpx;
    background-color: #008AFF;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .add-btn-text {
    color: #fff;
    font-size: 36rpx;
    font-weight: bold;
  }
</style>
