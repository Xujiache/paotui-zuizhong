# 默认：所有文本文件用 LF
* text=auto eol=lf

# Windows 专属脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix/Linux shell 脚本强制 LF
*.sh text eol=lf

# 二进制（不做换行处理）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary

# SQL 文件用 LF
*.sql text eol=lf

# Markdown 保留原始换行（不要强制）
*.md text
